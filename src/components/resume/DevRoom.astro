  /* The mascot's size lives here (so the warp can shrink it), and it leans into its walk. */
  .dr-svg .m-warp {
    transform: scale(0.92);
    transition:
      transform 220ms var(--ease),
      opacity 220ms var(--ease);
  }
  .dr-svg .warp .m-warp {
    transform: scale(0.1) translateY(-30px);
    opacity: 0;
  }
  .dr-svg .m-shadow {
    transition: opacity 220ms var(--ease);
  }
  .dr-svg .warp .m-shadow {
    opacity: 0;
  }
  .dr-svg .m-hop {
    transition: transform 160ms var(--ease);
  }
  /* The mascot's frames: the sheet slides inside the one-frame window. Idle by default; the walk cycles eight frames;
     each station plays its own poses on the station's 6 s clock. */
  .dr-svg .hero {
    overflow: hidden;
  }
  .dr-svg .hero-img {
    transform: translateX(-768px);
  }
  .dr-svg .float .hero-img {
    transform: translateX(-1824px);
  }
  .dr-svg [data-pose='sit'] .hero-img {
    transform: translateX(-1920px);
  }
  .dr-svg [data-pose='sit'] .m-shadow {
    opacity: 0;
  }
  .dr-svg [data-pose='lever'] .hero-img {
    transform: translateX(-1056px);
  }
  .dr-svg [data-pose='point'] .hero-img {
    transform: translateX(-1248px);
  }
  .dr-svg [data-pose='carry'] .hero-img {
    transform: translateX(-1344px);
  }
  .dr-svg [data-pose='conduct'] .hero-img {
    transform: translateX(-1440px);
  }
  .dr-svg :is([data-pose='raise'], [data-pose='lift']) .hero-img {
    transform: translateX(-1632px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .dr-svg .walk:not(.float) .hero-img {
      animation: hero-walk 0.72s steps(8) infinite;
    }
    .dr-svg .mascot:not(.walk):not(.float):not([data-pose]) .hero-img {
      animation: hero-idle 7s steps(1) infinite;
    }
    .dr-svg [data-pose='sit'] .hero-img {
      animation: hero-sit 0.5s steps(1) infinite;
    }
    .dr-svg [data-pose='lever'] .hero-img {
      animation: hero-lever 6s steps(1) infinite;
    }
    .dr-svg [data-pose='point'] .hero-img {
      animation: hero-point 6s steps(1) infinite;
    }
    .dr-svg [data-pose='carry'] .hero-img {
      animation: hero-carry 6s steps(1) infinite;
    }
    .dr-svg [data-pose='conduct'] .hero-img {
      animation: hero-conduct 1.2s steps(1) infinite;
    }
    .dr-svg :is([data-pose='raise'], [data-pose='lift']) .hero-img {
      animation: hero-cheer 6s steps(1) infinite;
    }
