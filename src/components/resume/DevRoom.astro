    stroke: color-mix(in srgb, var(--bg) 60%, transparent);
  }
  .dr-svg .n .m {
    fill: color-mix(in srgb, var(--text) 6.5%, var(--surface));
  }
  .dr-svg .l .m {
    fill: color-mix(in srgb, var(--text) 68%, var(--bg));
  }
  .dr-svg .a .m {
    fill: color-mix(in srgb, var(--accent) 62%, var(--bg));
  }
  .dr-svg .dith {
    fill: url(#dr-dither);
    pointer-events: none;
  }
  .dr-svg .lf {
    fill: color-mix(in srgb, var(--verified) 62%, var(--bg));
  }
  .dr-svg .lf2 {
    fill: color-mix(in srgb, var(--verified) 42%, var(--bg));
  }
  .dr-svg .drape {
    fill: color-mix(in srgb, #c4683f 58%, var(--bg));
    stroke: color-mix(in srgb, #c4683f 80%, transparent);
  }
  .dr-svg .fold {
    fill: none;
    stroke: color-mix(in srgb, var(--bg) 45%, transparent);
    stroke-width: 1.2;
  }
  .dr-svg .steam {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 45%, transparent);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 4 3;
  }
  .dr-svg .bean-b {
    fill: color-mix(in srgb, var(--neon-m) 38%, var(--bg));
    stroke: var(--bg);
  }
  .dr-svg .bean-c {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 30%, transparent);
    stroke-width: 1.2;
  }
  .dr-svg .arc {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 50%, var(--bg));
    stroke-width: 2;
  }
  .dr-svg .shade {
    fill: var(--partial);
    stroke: var(--bg);
  }
  .dr-svg .cloud {
    fill: color-mix(in srgb, var(--accent) 12%, var(--bg));
    opacity: 0.85;
  }
  .dr-svg .canopy {
    fill: color-mix(in srgb, var(--verified) 40%, var(--bg));
    stroke: var(--bg);
  }
  .dr-svg .canopy-hi {
    fill: none;
    stroke: color-mix(in srgb, var(--verified) 70%, var(--bg));
    stroke-width: 1.5;
  }
  /* Neon, light and holograms. */
  .dr-svg :is(.nh, .nc) {
    fill: none;
    stroke-linecap: round;
    pointer-events: none;
  }
  .dr-svg .nh {
    stroke-width: 7;
    opacity: 0.26;
  }
  .dr-svg .nc {
    stroke-width: 1.8;
  }
  .dr-svg :is(.nh, .nc).m {
    stroke: var(--neon-m);
  }
  .dr-svg :is(.nh, .nc).c {
    stroke: var(--neon-c);
  }
  .dr-svg :is(.refl, .shaft, .under) {
    pointer-events: none;
  }
  .dr-svg .slat {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 30%, transparent);
    stroke-width: 1.1;
  }
  .dr-svg .holo-p {
    fill: color-mix(in srgb, var(--neon-c) 12%, transparent);
    stroke: color-mix(in srgb, var(--neon-c) 75%, transparent);
  }
  .dr-svg .scan {
    fill: none;
    stroke: color-mix(in srgb, var(--neon-c) 28%, transparent);
  }
  .dr-svg .holo-l {
    fill: none;
    stroke: var(--neon-c);
    stroke-width: 1.6;
  }
  .dr-svg .holo-g {
    pointer-events: none;
  }
  .dr-svg :is(.nsign-c, .nsign-h) {
    font-size: 22px;
    font-weight: 700;
  }
  .dr-svg .nsign-c {
    fill: var(--neon-c);
  }
  .dr-svg .nsign-h {
    fill: none;
    stroke: color-mix(in srgb, var(--neon-c) 35%, transparent);
    stroke-width: 6px;
  }
  .dr-svg .vend {
    fill: color-mix(in srgb, var(--neon-c) 30%, var(--bg));
    stroke: var(--neon-c);
  }
  .dr-svg .vend-slot {
    fill: var(--neon-m);
  }
  .dr-svg .bw.m {
    fill: color-mix(in srgb, var(--neon-m) 40%, var(--bg));
  }
  .dr-svg .bw.c {
    fill: color-mix(in srgb, var(--neon-c) 35%, var(--bg));
  }
  .dr-svg .bill {
    fill: color-mix(in srgb, var(--neon-m) 55%, var(--bg));
  }
  .dr-svg .fcar rect {
    fill: color-mix(in srgb, var(--text) 60%, var(--bg));
  }
  .dr-svg .flite {
    fill: var(--neon-c);
  }
  .dr-svg .ftrail {
    stroke: color-mix(in srgb, var(--neon-m) 45%, transparent);
    stroke-width: 1.4;
  }
  .dr-svg .fcar.f1 {
    transform: translate(-80px, 150px);
  }
  .dr-svg .fcar.f2 {
    transform: translate(1040px, 60px);
  }
  /* Stations are links into the page. Pointing at one, or at its point, lights its floor pad. */
  .dr-svg .st {
    cursor: pointer;
  }
  .dr-svg .st:focus {
    outline: none;
  }
  .dr-svg .pad {
    fill: color-mix(in srgb, var(--accent) 12%, transparent);
    stroke: var(--accent);
    stroke-dasharray: 4 3;
    opacity: 0;
    transition: opacity var(--m-state) var(--ease);
  }
  /* The focus layer: a pool of light, a cone and rising sparks at the active station. */
  .dr-svg .fx-focus {
    pointer-events: none;
  }
  .dr-svg .fspot {
    opacity: 0;
    transition: opacity 500ms var(--ease);
  }
  .dr-svg .fspot.is-on {
    opacity: 1;
  }
  .dr-svg .fp-ring {
    fill: none;
    stroke: #ffd98a;
    stroke-opacity: 0.7;
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
    vector-effect: non-scaling-stroke;
  }
  .dr-svg .fp-mote {
    fill: #ffe3a3;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dr-svg .fspot.is-on .fp-mote {
      animation: fp-rise 2.4s ease-in infinite;
      animation-delay: var(--d);
    }
    .dr-svg .fspot.is-on .fp-ring {
      animation: fp-run 8s linear infinite;
    }
  }
  @keyframes fp-rise {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    20% {
      opacity: 0.9;
    }
    100% {
      transform: translateY(-110px);
      opacity: 0;
    }
  }
  @keyframes fp-run {
    to {
      stroke-dashoffset: -72;
    }
  }
  .dr-svg .st:is(:hover, :focus-visible, .is-hover, .is-on) .pad {
    opacity: 1;
  }
  .dr-svg .st:focus-visible .pad {
    stroke-width: 2;
  }
  .floor-u {
    opacity: 0;
    visibility: hidden;
  }

  /* Scene parts at rest: the state shown without scripts, and before a station is reached. */
  .dr-svg .q {
    fill: color-mix(in srgb, var(--text) 16%, var(--bg));
  }
  .dr-svg .bar.old {
    fill: color-mix(in srgb, var(--invalid) 60%, var(--bg));
  }
  .dr-svg :is(.bar.new, .new-t) {
    fill: var(--verified);
    opacity: 0;
  }
  .dr-svg .lamp {
    fill: var(--verified);
  }
  .dr-svg .card {
    opacity: 0;
  }
  .dr-svg .card.c3 {
    opacity: 1;
  }
  .dr-svg .sorted,
  .dr-svg .landed {
    opacity: 0;
  }
  .dr-svg .ld {
    fill: var(--verified);
    opacity: 0.6;
  }
  .dr-svg .pl {
    fill: color-mix(in srgb, var(--text) 20%, var(--bg));
    stroke: color-mix(in srgb, var(--text) 50%, transparent);
  }
  .dr-svg .lnp {
    fill: var(--accent);
    opacity: 0.5;
  }
  .dr-svg .tsp {
    fill: var(--invalid);
  }
  .dr-svg .tick {
    fill: var(--verified);
    opacity: 0;
  }
  .dr-svg .spot {
    fill: color-mix(in srgb, var(--partial) 18%, transparent);
    opacity: 0;
    transition: opacity 400ms var(--ease);
    pointer-events: none;
  }
  .dr-svg :is(.spark, .conf, .holo) {
    opacity: 0;
  }
  .dr-svg .spark {
    fill: var(--partial);
  }
  .dr-svg .conf {
    fill: var(--partial);
  }
  .dr-svg .conf:nth-child(3n) {
    fill: var(--accent);
  }
  .dr-svg .conf:nth-child(3n + 1) {
    fill: var(--verified);
  }

  /* The mascot. */
  .dr-svg .mascot {
    pointer-events: none;
  }
  .dr-svg .m-shadow {
    fill: #000;
    stroke: none;
    opacity: 0.35;
  }
  .dr-svg .m-box {
    opacity: 0;
  }
  .dr-svg .m-box .bt {
    fill: var(--accent);
  }
  .dr-svg .m-box .bf {
    fill: color-mix(in srgb, var(--accent) 72%, var(--bg));
  }
  .dr-svg .m-box .be {
    fill: color-mix(in srgb, var(--accent) 52%, var(--bg));
  }
  /* Floating in the portal's beam: arms out, legs together. */
  .dr-svg .float .m-shadow {
    opacity: 0.08;
  }
  /* Poses that hold still: sitting at the desk, pointing from the stool. */

  @media (prefers-reduced-motion: no-preference) {
    .dr-svg .clock .h1 {
      animation: dr-spin 12s linear infinite;
    }
    .dr-svg .clock .h2 {
      animation: dr-spin 60s linear infinite;
    }
    .dr-svg .sky-star.tw {
      animation: dr-twinkle 3.4s ease-in-out infinite alternate;
      animation-delay: var(--d);
    }
    .dr-svg .bw.tw {
      animation: dr-twinkle 5s steps(2) infinite alternate;
    }
    .dr-svg .beacon,
    .dr-svg .nav {
      animation: dr-blink-led 1.2s steps(2) infinite;
      animation-delay: var(--d, 0s);
    }
    .dr-svg .plane {
      animation: dr-fly 26s linear infinite;
    }
    .dr-svg .car {
      animation: dr-drive 13s linear infinite;
    }
    .dr-svg .steam {
      animation: dr-steam 2.4s linear infinite;
    }
    .dr-svg .cloud {
      animation: dr-cloud 60s linear infinite;
      animation-delay: var(--d);
    }
    .dr-svg .plant {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: dr-sway 5s ease-in-out infinite alternate;
    }
    .dr-svg .holo-g {
      animation: dr-holo-flicker 3.2s steps(1) infinite;
    }
    .dr-svg .nsign {
      animation: dr-neon-flicker 5s steps(1) infinite;
    }
    .dr-svg .bill {
      animation: dr-bill 9s linear infinite;
    }
    .dr-svg .fcar.f1 {
      animation: dr-fcar1 11s linear infinite;
    }
    .dr-svg .fcar.f2 {
      animation: dr-fcar2 15s linear -6s infinite;
    }

    .dr-svg .birds {
      animation: dr-birds 34s linear infinite;
    }
    .dr-svg .birds path {
      animation: dr-flap 0.7s ease-in-out infinite alternate;
      transform-box: fill-box;
      transform-origin: 50% 100%;
    }
    .dr-svg .fly {
      animation: dr-drift 7s ease-in-out infinite alternate;
      animation-delay: var(--d);
    }
    .dr-svg .bulb.tw {
      animation: dr-twinkle 2.2s ease-in-out infinite alternate;
      animation-delay: var(--d);
    }
    .dr-svg .cat {
      animation: dr-breathe 3.2s ease-in-out infinite;
    }
    .dr-svg .fire path {
      animation: dr-flicker 0.42s ease-in-out infinite alternate;
    }
    .dr-svg .fire .fl2 {
      animation-duration: 0.36s;
      animation-delay: -0.2s;
    }
    .dr-svg .fire .fl3 {
      animation-duration: 0.5s;
    }
    .dr-svg .fire .fl4 {
      animation-duration: 0.3s;
    }
    .dr-svg .prune {
      animation: dr-rune 3s linear infinite;
    }
    .dr-svg .pcore {
      animation: dr-pulse 1.4s ease-in-out infinite alternate;
    }
    .dr-svg .mote {
      animation: dr-mote 2.7s ease-in infinite;
      animation-delay: var(--d);
    }

    /* The poses, on the same 6 s clock as the stations. */
    .dr-svg [data-pose='carry'] .m-box {
      animation: dr-hold 6s infinite;
    }
    .dr-svg [data-pose='carry'] .m-shuttle {
      animation: dr-shuttle 6s ease-in-out infinite;
    }
    .dr-svg [data-pose='raise'] .m-hop {
      animation: dr-jump 6s ease-in-out infinite;
    }

    /* 01 */
    .dr-svg .is-on .tile .q {
      animation: dr-tile 6s infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .redis {
      animation: dr-hop 6s infinite;
    }
    .dr-svg .is-on .ttl {
      animation: dr-ttl 6s linear infinite;
    }
    .dr-svg .is-on .bar.old {
      animation: dr-old 6s infinite;
    }
    .dr-svg .is-on :is(.bar.new, .new-t) {
      animation: dr-new 6s infinite;
    }
    .dr-svg .is-on .ig .gbar {
      animation: ig-sort 6s ease-in-out infinite;
    }
    .dr-svg .is-on .ig .gbar.top {
      animation:
        ig-sort 6s ease-in-out infinite,
        ig-top 6s infinite;
    }
    .dr-svg .is-on .ig .bmark {
      animation: dr-new 6s infinite;
    }
    .dr-svg .is-on .ig .agline {
      animation: dr-line 6s infinite;
      animation-delay: calc(var(--i) * 0.25s);
    }
    .dr-svg .is-on .ig .chk {
      animation: ig-check 6s infinite;
      animation-delay: calc(var(--i) * 0.3s);
    }
    .dr-svg .is-on .ig .tst {
      animation: dr-green 6s infinite;
      animation-delay: calc(var(--i) * 0.18s);
    }
    /* 02 */
    .dr-svg .is-on .belt {
      animation: dr-belt 0.6s linear infinite;
    }
    .dr-svg .is-on .card.c1 {
      animation: dr-card1 6s linear infinite;
    }
    .dr-svg .is-on .card.c2 {
      animation: dr-card2 6s linear infinite;
    }
    .dr-svg .is-on .card.c3 {
      animation: dr-card3 6s linear infinite;
    }
    .dr-svg .is-on .card.c2 :is(.t, .f, .e, .m) {
      animation: dr-red 6s linear infinite;
    }
    .dr-svg .is-on .lamp {
      animation: dr-lamp 6s linear infinite;
    }
    .dr-svg .is-on .lever {
      animation: dr-pull 6s ease-in-out infinite;
    }
    .dr-svg .is-on .n14 {
      animation: dr-old 6s infinite;
    }
    .dr-svg .is-on .n15 {
      animation: dr-new 6s infinite;
    }
    /* 03 */
    .dr-svg .is-on .stack {
      animation: dr-stack 6s infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .raw {
      animation: dr-raw 6s infinite;
    }
    .dr-svg .is-on .sorted {
      opacity: 1;
    }
    .dr-svg .is-on .sorted > g {
      animation: dr-rise 6s infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .hit {
      animation: dr-new 6s infinite;
    }
    /* 04 */
    .dr-svg .is-on .led .ld {
      animation: dr-blink-led 0.9s steps(2) infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .pl {
      animation: dr-pl 6s infinite;
      animation-delay: calc(var(--d) * 0.45s);
    }
    .dr-svg .is-on .pick {
      animation: dr-picked 6s infinite;
    }
    .dr-svg .is-on .landed {
      animation: dr-new 6s infinite;
    }
    /* 05 */
    .dr-svg .is-on .tick {
      animation: dr-tick 6s infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .ln .lnp {
      animation: dr-line 6s infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .orb.o1 {
      animation: dr-orbit 6s ease-in-out infinite;
    }
    .dr-svg .is-on .orb.o2 {
      animation: dr-orbit 6s ease-in-out -0.4s infinite reverse;
    }
    .dr-svg .is-on .tsp {
      animation: dr-green 6s infinite;
    }
    .dr-svg .is-on .ts:nth-child(2) .tsp {
      animation-delay: 0.15s;
    }
    /* 08 */
    .dr-svg .is-on .ig .rkey {
      animation: dr-tick 6s infinite;
      animation-delay: calc(var(--i) * 0.3s);
    }
    .dr-svg .is-on .ig .rkey.k1 {
      animation: ig-expire 6s infinite;
    }
    .dr-svg .is-on .ig .rttl {
      animation:
        ig-ttl 6s infinite,
        ig-run 1.2s linear infinite;
    }
    .dr-svg .is-on .ig .rglow {
      animation: dr-new 6s infinite;
    }
    .dr-svg .is-on .ig[data-ig='redis'] .lay {
      animation: ig-lift 6s ease-in-out infinite;
    }
    /* 06 and 07 */
    .dr-svg .is-on .spot {
      opacity: 1;
    }
    .dr-svg .is-on .holo {
      animation: dr-holo 6s ease-out infinite;
    }
    .dr-svg .is-on .conf {
      animation: dr-conf 6s ease-in infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .trophy {
      animation: dr-lift 6s ease-in-out infinite;
    }
    .dr-svg .is-on .spark {
      animation: dr-spark 6s ease-out infinite;
      animation-delay: var(--d);
    }
    .dr-svg .is-on .cframe {
      animation: dr-frame 6s infinite;
    }
  }

  /* Reduced motion: nothing moves, but a reached station still shows its result. */
  @media (prefers-reduced-motion: reduce) {
    .dr-svg .is-on .tile .q {
      fill: var(--accent);
    }
    .dr-svg .is-on :is(.bar.new, .new-t, .sorted, .tick, .spot, .landed, .hit, .n15, .holo) {
      opacity: 1;
    }
    .dr-svg .is-on :is(.bar.old, .n14) {
      opacity: 0.3;
    }
    .dr-svg .is-on .raw {
      opacity: 0;
    }
    .dr-svg .is-on :is(.pl, .tsp) {
      fill: var(--verified);
    }
  }

  @keyframes dr-blink {
    0%,
    94%,
    100% {
      transform: scaleY(1);
    }
    97% {
      transform: scaleY(0.1);
    }
  }
  @keyframes dr-pulse {
    to {
      opacity: 0.35;
    }
  }
  @keyframes dr-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes dr-breathe-m {
    0%,
    100% {
      transform: scale(1, 1);
    }
    50% {
      transform: scale(1.02, 1.04);
    }
  }
  @keyframes dr-look {
    0%,
    30%,
    70%,
    100% {
      transform: translateX(0);
    }
    40%,
    55% {
      transform: translateX(1.6px);
    }
  }
  @keyframes dr-steam {
    to {
      stroke-dashoffset: -14;
    }
  }
  @keyframes dr-cloud {
    from {
      transform: translateX(-120px);
    }
    to {
      transform: translateX(120px);
    }
  }
  @keyframes dr-sway {
    from {
      transform: rotate(-2deg);
    }
    to {
      transform: rotate(2deg);
    }
  }
  @keyframes dr-holo-flicker {
    0%,
    46%,
    50%,
    100% {
      opacity: 0.95;
    }
    48% {
      opacity: 0.5;
    }
  }
  @keyframes dr-neon-flicker {
    0%,
    62%,
    66%,
    70%,
    100% {
      opacity: 1;
    }
    64%,
    68% {
      opacity: 0.35;
    }
  }
  @keyframes dr-bill {
    0%,
    100% {
      fill: color-mix(in srgb, var(--neon-m) 55%, var(--bg));
    }
    33% {
      fill: color-mix(in srgb, var(--neon-c) 55%, var(--bg));
    }
    66% {
      fill: color-mix(in srgb, var(--partial) 55%, var(--bg));
    }
  }
  @keyframes dr-fcar1 {
    from {
      transform: translate(-80px, 150px);
    }
    to {
      transform: translate(1060px, 90px);
    }
  }
  @keyframes dr-fcar2 {
    from {
      transform: translate(1040px, 60px);
    }
    to {
      transform: translate(-90px, 110px);
    }
  }
  @keyframes dr-drive {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(var(--cx), var(--cy));
    }
  }
  @keyframes dr-twinkle {
    to {
      opacity: 0.15;
    }
  }
  @keyframes dr-fly {
    from {
      transform: translate(-60px, 190px);
    }
    to {
      transform: translate(1040px, 40px);
    }
  }
  @keyframes dr-birds {
    from {
      transform: translate(-40px, 130px);
    }
    to {
      transform: translate(1000px, 70px);
    }
  }
  @keyframes dr-flap {
    to {
      transform: scaleY(0.4);
    }
  }
  @keyframes dr-drift {
    from {
      transform: translate(0, 0);
      opacity: 0.15;
    }
    to {
      transform: translate(14px, -22px);
      opacity: 0.8;
    }
  }
  @keyframes dr-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05, 1.08);
    }
  }
  @keyframes dr-flicker {
    from {
      transform: scale(0.92, 0.82);
    }
    to {
      transform: scale(1.06, 1.08);
    }
  }
  @keyframes dr-glow {
    from {
      opacity: 0.7;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes dr-rune {
    to {
      stroke-dashoffset: -24;
    }
  }
  @keyframes dr-mote {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    20% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
