---
// The résumé's experience and certifications as a scroll story: a pinned, two-floor isometric dev room on one side, the
// CV points on the other. As each point reaches the middle of the screen, the mascot walks to its station (and up through
// the portal for the certifications) and acts it out in three beats; the words on the page that each beat shows light at
// the same moment, with a small live readout of the point's own numbers. Without scripts this is a plain, complete list; with reduced motion nothing moves.
import { renderRail, renderRoom } from '../../lib/resume/room.ts';
import Pulse from './Pulse.astro';
import Waypoint from './Waypoint.astro';

type Fact = (string | number)[];
type Point = {
  id: string;
  place: string;
  title: string;
  lede: string;
  text: string;
  facts: Fact[];
  pulse: string;
  stack: string[];
};
type Cert = {
  id: string;
  name: string;
  by: string;
  when: string;
  href: string;
  link: string;
  logo: string;
  logoAlt: string;
  place: string;
  lede: string;
  facts: Fact[];
  pulse: string;
  covers?: (string | number)[][];
  format?: string;
};
interface Props {
  work: { role: string; org: string; dates: string; place: string; summary: string };
  points: Point[];
  certs: Cert[];
}
const { work, points, certs } = Astro.props;
const svg = renderRoom([
  ...points.map((p, i) => ({ id: p.id, label: `Station ${i + 1}, ${p.place.toLowerCase()}: ${p.title}` })),
  ...certs.map((c, i) => ({ id: c.id, label: `Station ${points.length + i + 1}, upstairs: ${c.name}` })),
]);
/** CV text with beats marked [[n:words]]: plain chunks and beat chunks, in order. */
const beats = (t: string) =>
  t.split(/\[\[(\d):(.*?)\]\]/).reduce<{ b: string | null; s: string }[]>((out, s, i, all) => {
    if (i % 3 === 0) out.push({ b: null, s });
    else if (i % 3 === 2) out.push({ b: all[i - 1]!, s });
    return out;
  }, []);
const pad = (n: number) => String(n).padStart(2, '0');
const total = points.length + certs.length;
const rail = renderRail(['desk', 'conveyor', 'board', 'rack', 'agents', 'fireplace', 'trophies']);
/** Each walk on the page: where it ends, and the picture of that station. */
const walks: [string, string][] = [
  ['the desk', 'desk'],
  ['the conveyor', 'conveyor'],
  ['the whiteboard', 'board'],
  ['the rack', 'rack'],
  ['the standing desk', 'agents'],
  ['the fireplace', 'portal'],
  ['the trophy case', 'trophy'],
];
---

<div class="droom" data-droom>
  <div class="dr-left">
    <div class="dr-stage">
      <p class="dr-floor mono" data-floor aria-hidden="true">
        Ground floor · the work
      </p>
      <div class="dr-scene">
        <Fragment set:html={svg} />
      </div>
      <p class="dr-hint mono" aria-hidden="true">
        scroll to walk · click a station to jump or replay
      </p>
    </div>

    <div class="dr-rail">
      <Fragment set:html={rail} />
    </div>
  </div>

  <div class="dr-steps">
    <section aria-labelledby="exp-h">
      <h2 id="exp-h">
        <span>01</span> Work experience
      </h2>
      <div class="dr-intro" data-intro>
        <div class="etop">
          <h3>
            {work.role} <span class="at">at {work.org}</span>
          </h3>
          <p class="edate">
            {work.dates}
            <span>{work.place}</span>
          </p>
        </div>
        <p class="esum">{work.summary}</p>
        <p class="dr-how mono">
          Five points, five stations on the ground floor. Each plays in three beats, and the words that match
          each beat light up as it happens.
        </p>
        <Waypoint k={0} to={walks[0]![0]} kind={walks[0]![1]} />
      </div>
      <ol class="dr-list">
        {points.map((p, i) => (
          <>
            {i > 0 && <Waypoint k={i} to={walks[i]![0]} kind={walks[i]![1]} li />}
            <li class="step" id={p.id} data-step={i}>
              <p class="snum mono">
                {pad(i + 1)} / {pad(total)} · {p.place}
              </p>
              <h4>{p.title}</h4>
              <p class="lede">{p.lede}</p>
              <p class="stext">
                {beats(p.text).map((c) => (c.b ? <span class={`beat b${c.b}`}>{c.s}</span> : c.s))}
              </p>
              <dl class="facts">
                {p.facts.map(([k, v, b]) => (
                  <div class={`fact b${b}`}>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
              <Pulse kind={p.pulse} />
              <ul class="dr-chips" aria-label="Technologies">
                {p.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </li>
          </>
        ))}
      </ol>
    </section>

    <section aria-labelledby="cert-h">
      <h2 id="cert-h">
        <span>02</span> Certifications
      </h2>
      <p class="dr-how mono">Through the portal to the second floor, where the certificates are kept.</p>
      <Waypoint k={points.length} to={walks[points.length]![0]} kind="portal" up />
      <ol class="dr-list">
        {certs.map((c, i) => (
          <>
            {i > 0 && (
              <Waypoint
                k={points.length + i}
                to={walks[points.length + i]![0]}
                kind={walks[points.length + i]![1]}
                li
              />
            )}
            <li class="step" id={c.id} data-step={points.length + i}>
              <p class="snum mono">
                {pad(points.length + i + 1)} / {pad(total)} · {c.place}
              </p>
              <div class="cert">
                <img
                  class="clogo"
                  src={c.logo}
                  alt={c.logoAlt}
                  width="84"
                  height="84"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <h3>{c.name}</h3>
                  <p>{c.by}</p>
                  <p class="muted mono">{c.when}</p>
                  <p>
                    <a class="arrow-link" href={c.href} rel="noopener">
                      {c.link} →
                    </a>
                  </p>
                </div>
              </div>
              <p class="lede">{c.lede}</p>
              {c.covers && (
                <div class="covers">
                  <p class="mono covers-h">What it covers</p>
                  <ul>
                    {c.covers.map(([label, w]) => (
                      <li>
                        <span>{label}</span>
                        {w ? (
                          <>
                            <i style={`--w:${w}`} />
                            <b class="mono">{w}%</b>
                          </>
                        ) : null}
                      </li>
                    ))}
                  </ul>
                  {c.format && <p class="mono covers-f">{c.format}</p>}
                </div>
              )}
              <dl class="facts">
                {c.facts.map(([k, v, b]) => (
                  <div class={`fact b${b}`}>
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
              <Pulse kind={c.pulse} />
            </li>
          </>
        ))}
      </ol>
    </section>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-droom]');
  const svg = root?.querySelector<SVGSVGElement>('.dr-svg');
  const mascot = svg?.querySelector<SVGGElement>('[data-mascot]');
  const flip = svg?.querySelector<SVGGElement>('[data-flip]');
  const cam = svg?.querySelector<SVGGElement>('[data-cam]');
  const art = svg?.querySelector<SVGGElement>('[data-art]');
  const groundWords = svg?.querySelector<SVGGElement>('.lbl-g');
  const upperWords = svg?.querySelector<SVGGElement>('.lbl-u');
  const groundFloor = svg?.querySelector<SVGGElement>('.floor-g');
  const upperFloor = svg?.querySelector<SVGGElement>('.floor-u');
  const outside = svg?.querySelector<SVGGElement>('[data-outside]');
  if (root && svg && mascot && flip && cam && art && groundWords && upperWords && groundFloor && upperFloor) {
    root.classList.add('is-live');
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const intro = root.querySelector<HTMLElement>('[data-intro]')!;
    const stage = root.querySelector<HTMLElement>('.dr-stage')!;
    const floorLabel = root.querySelector<HTMLElement>('[data-floor]')!;
    const stations = [...svg.querySelectorAll<SVGAElement>('.st')].sort(
      (a, b) => Number(a.dataset.st) - Number(b.dataset.st),
    );
    const route = JSON.parse(svg.dataset.route!) as [number, number][];
    const zs = JSON.parse(svg.dataset.z!) as number[];
    const stops = JSON.parse(svg.dataset.stops!) as number[];
    const PAN = Number(svg.dataset.pan);
    const UP = Number(svg.dataset.up);
    const vb = svg.viewBox.baseVal;
    // Distance along the route (in view units) at each point, and at each stop: the door, then one per station.
    const dist = [0];
    for (let i = 1; i < route.length; i++)
      dist.push(dist[i - 1]! + Math.hypot(route[i]![0] - route[i - 1]![0], route[i]![1] - route[i - 1]![1]));
    const at = stops.map((i) => dist[i]!);
    const pointAt = (d: number): [number, number, number] => {
      let i = 1;
      while (i < route.length - 1 && dist[i]! < d) i++;
      const [a, b] = [route[i - 1]!, route[i]!];
      const t = Math.min(1, Math.max(0, (d - dist[i - 1]!) / (dist[i]! - dist[i - 1]! || 1)));
      return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, zs[i - 1]! + (zs[i]! - zs[i - 1]!) * t];
    };
    const ease = (t: number) => t * t * (3 - 2 * t);
    const clamp = (v: number, lo = 0, hi = 1) => Math.min(hi, Math.max(lo, v));
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const railSvg = root.querySelector<SVGSVGElement>('[data-rail]');
    const railIcon = railSvg?.querySelector<SVGGElement>('[data-rail-icon]');
    const railFill = railSvg?.querySelector<SVGLineElement>('[data-rail-fill]');
    const railNodes = [...(railSvg?.querySelectorAll<SVGGElement>('[data-node]') ?? [])];
    const railY = railSvg ? (JSON.parse(railSvg.dataset.y!) as number[]) : [];
    const railX = Number(railSvg?.dataset.x ?? 0);
    const stacked = matchMedia('(max-width: 999px)');

    let cur = 0;
    let target = 0;
    let want = -1;
    let on = -1;
    let face = 1;
    let view = { x: 0, y: 0 };
    let raf = 0;
    let level = -1;

    // Where the reader is. The focus line is the middle of the space the points scroll through (on a phone, the part
    // below the pinned room). Each point holds the mascot at its station for the middle of its height; the walk to the
    // next station is spread over the scroll in between.
    const walksOnPage = [...root.querySelectorAll<HTMLElement>('[data-transit]')].sort(
      (a, b) => Number(a.dataset.transit) - Number(b.dataset.transit),
    );
    let walkK = -1;
    let walkT = 0;
    // The walk in progress lights its footprints; walks already made stay lit, walks ahead stay dark.
    const footprints = () => {
      const done = walkK >= 0 ? walkK : want + 1;
      walksOnPage.forEach((el, k) => {
        el.classList.toggle('is-walking', k === walkK);
        el.style.setProperty('--t', k === walkK ? walkT.toFixed(3) : k < done ? '1' : '0');
      });
    };
    const measure = () => {
      locate();
      footprints();
    };
    const locate = () => {
      const vh = innerHeight;
      const top = stacked.matches ? Math.max(0, stage.getBoundingClientRect().bottom) : 0;
      const focus = top + (vh - top) * 0.5;
      const rects = steps.map((s) => s.getBoundingClientRect());
      const arrive = (r: DOMRect) => r.top + r.height * 0.28;
      const leave = (r: DOMRect) => r.top + r.height * 0.72;
      want = -1;
      walkK = -1;
      const first = arrive(rects[0]!);
      const start = Math.min(intro.getBoundingClientRect().top, first - 160);
      if (focus < first) {
        walkT = clamp((focus - start) / (first - start));
        walkK = walkT > 0 ? 0 : -1;
        target = at[0]! + (at[1]! - at[0]!) * ease(walkT);
        return;
      }
      for (let i = 0; i < rects.length; i++) {
        if (focus <= leave(rects[i]!)) {
          want = i;
          target = at[i + 1]!;
          return;
        }
        const next = rects[i + 1];
        if (next && focus < arrive(next)) {
          walkT = clamp((focus - leave(rects[i]!)) / (arrive(next) - leave(rects[i]!)));
          walkK = i + 1;
          target = at[i + 1]! + (at[i + 2]! - at[i + 1]!) * ease(walkT);
          return;
        }
      }
      want = rects.length - 1;
      target = at[at.length - 1]!;
    };

    const words = [...svg.querySelectorAll<SVGGElement>('.stl')].sort(
      (a, b) => Number(a.dataset.stl) - Number(b.dataset.stl),
    );
    const play = (i: number, restart = false) => {
      if (i === on && !restart) return;
      stations[on]?.classList.remove('is-on');
      words[on]?.classList.remove('is-on');
      steps[on]?.classList.remove('is-active');
      delete mascot.dataset.pose;
      on = i;
      if (on < 0) return;
      if (restart) void svg.getBoundingClientRect();
      stations[on]!.classList.add('is-on');
      words[on]?.classList.add('is-on');
      steps[on]!.classList.add('is-active');
      mascot.dataset.pose = stations[on]!.dataset.pose;
    };

    // The mascot walks at a steady pace, as a character in a pixel RPG does, rather than gliding: a walking speed that
    // rises a little when it has far to go, so it never falls far behind the page.
    let last = 0;
    let snap = false;
    const frame = (now: number = performance.now()) => {
      raf = 0;
      const dt = last ? Math.min(0.05, (now - last) / 1000) : 1 / 60;
      last = now;
      const before = pointAt(cur);
      const gap = target - cur;
      const pace = (150 + Math.abs(gap) * 1.4) * dt;
      if (snap || reduce.matches || Math.abs(gap) <= pace) cur = target;
      else cur += Math.sign(gap) * pace;
      const [px, py, z] = pointAt(cur);
      const [x, y] = [px, py];
      const walking = Math.abs(target - cur) > 0.4;
      const arrived = want >= 0 && !walking && Math.abs(cur - at[want + 1]!) < 1;
      if (arrived) face = Number(stations[want]!.dataset.face) as 1 | -1;
      else if (Math.abs(px - before[0]) > 0.05) face = px > before[0] ? 1 : -1;
      mascot.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)})`);
      flip.setAttribute('transform', `scale(${face} 1)`);
      mascot.classList.toggle('walk', walking);
      // Between the floors the mascot is in the portal's beam: it floats instead of walking.
      const floating = z > 6.5 && z < UP - 0.5;
      mascot.classList.toggle('float', floating);
      svg.classList.toggle('is-beam', floating);
      play(arrived ? want : -1);
      // The rail beside the text: the small mascot sits at the same point of the journey as the big one.
      if (railIcon && railFill) {
        let k = 0;
        while (k < at.length - 2 && cur > at[k + 1]!) k++;
        const f = clamp((cur - at[k]!) / (at[k + 1]! - at[k]! || 1));
        const ry = (railY[k]! + (railY[k + 1]! - railY[k]!) * f).toFixed(1);
        railIcon.setAttribute('transform', `translate(${railX} ${ry})`);
        railFill.setAttribute('y1', ry);
        railNodes.forEach((n, i) => {
          n.classList.toggle('is-past', cur >= at[i]! - 0.5);
          n.classList.toggle('is-here', i === on + 1 && on >= 0);
        });
        railSvg!.classList.toggle('is-beam', floating);
      }

      // Floors: the upper one fades in as the mascot climbs, the ground one fades out beneath it, and the camera pans up.
      const up = clamp(z / UP);
      groundFloor.style.opacity = String(1 - 0.62 * clamp((up - 0.25) / 0.6));
      upperFloor.style.opacity = String(clamp((up - 0.35) / 0.5));
      groundFloor.style.pointerEvents = up > 0.5 ? 'none' : '';
      upperFloor.style.visibility = up > 0.35 ? 'visible' : 'hidden';
      // The words on each floor follow its floor; the ground floor's step aside once the camera has gone up.
      groundWords.style.opacity = up > 0.3 ? '0' : groundFloor.style.opacity;
      upperWords.style.opacity = upperFloor.style.opacity;
      upperWords.style.visibility = upperFloor.style.visibility;
      // The city is further away than the room: it moves less as the camera rises.
      outside?.setAttribute('transform', `translate(0 ${(-0.45 * PAN * up).toFixed(1)})`);
      const floor = up > 0.5 ? 1 : 0;
      if (floor !== level) {
        level = floor;
        floorLabel.textContent = floor ? 'Level 2 · certifications' : 'Ground floor · the work';
      }
      // The camera: on a wide screen it shows the whole floor; on a phone it follows the mascot, closer in.
      const k = stacked.matches ? 1.6 : 1;
      const topEdge = -PAN * up;
      const bottomEdge = vb.height - PAN * up;
      const tx = clamp(vb.width / 2 - k * x, vb.width - k * vb.width, 0);
      const ty = clamp(vb.height / 2 - k * (y - 50), vb.height - k * bottomEdge, -k * topEdge);
      const lag = reduce.matches || snap ? 1 : 0.14;
      view = { x: view.x + (tx - view.x) * lag, y: view.y + (ty - view.y) * lag };
      snap = false;
      cam.setAttribute('transform', `translate(${view.x.toFixed(1)} ${view.y.toFixed(1)}) scale(${k})`);
      const settling = Math.abs(tx - view.x) > 0.5 || Math.abs(ty - view.y) > 0.5;
      if (walking || settling) raf = requestAnimationFrame(frame);
      else last = 0;
    };
    const update = () => {
      measure();
      if (!raf) raf = requestAnimationFrame(frame);
    };

    // On a wide screen the scene runs out to the window's left edge instead of stopping at the page margin.
    const bleed = () =>
      root.style.setProperty(
        '--bleed',
        stacked.matches ? '0px' : `${Math.max(0, Math.round(root.getBoundingClientRect().left))}px`,
      );
    bleed();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', () => {
      bleed();
      update();
    });
    stacked.addEventListener('change', update);

    // Stations are modular: clicking one sends the mascot straight there. It blinks out, the page jumps to that point,
    // and it blinks in at the station, instead of walking through every station in between.
    const warp = (i: number) => {
      if (reduce.matches) {
        steps[i]!.scrollIntoView({ block: 'center' });
        return;
      }
      mascot.classList.add('warp');
      setTimeout(() => {
        // 'instant', not 'auto': the page's own smooth scrolling would otherwise walk the mascot the long way.
        steps[i]!.scrollIntoView({ behavior: 'instant', block: 'center' });
        measure();
        snap = true;
        if (!raf) raf = requestAnimationFrame(frame);
        setTimeout(() => mascot.classList.remove('warp'), 60);
      }, 220);
    };

    // A station is a link to its point: it scrolls there, and clicking the station in use plays its scene again.
    for (const st of stations) {
      const i = Number(st.dataset.st);
      st.addEventListener('click', (e) => {
        e.preventDefault();
        if (i === on) play(i, true);
        else warp(i);
      });
    }
    // Pointing at a point on the page lights its station in the room.
    steps.forEach((step, i) => {
      step.addEventListener('pointerenter', () => stations[i]?.classList.add('is-hover'));
      step.addEventListener('pointerleave', () => stations[i]?.classList.remove('is-hover'));
    });
    update();
  }
</script>

<style is:global>
  @property --lit {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
  .droom {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    margin-bottom: 56px;
  }
  /* The room and the rail share the left column, so the text column lines up with the skills column further down. */
  .dr-left {
    display: flex;
    align-self: stretch;
    gap: clamp(12px, 1.6vw, 24px);
  }
  .dr-stage {
    position: sticky;
    top: 12px;
    flex: 1 1 auto;
    min-width: 0;
    height: calc(100vh - 24px);
    margin-left: calc(-1 * var(--bleed, 0px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  /* The scene has no frame: the city and the street run past the drawing and fade into the page at every edge. */
  .dr-scene {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;

    background: radial-gradient(
      120% 85% at 50% 38%,
      color-mix(in srgb, var(--accent) 9%, var(--bg)) 0%,
      var(--bg) 72%
    );
    /* It fades out across the margin on the left, reaching full strength where the page's text column begins. */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 calc(var(--bleed, 0px) + 32px), #000 97.5%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 88%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 calc(var(--bleed, 0px) + 32px), #000 97.5%, transparent),
      linear-gradient(to bottom, transparent, #000 9%, #000 88%, transparent);
    mask-composite: intersect;
  }
  .dr-svg {
    display: block;
    flex: none;
    width: 100%;
    height: auto;
    max-height: 100%;
    overflow: visible;
    font-family: var(--mono);
  }
  /* The room is full size, nudged right: away from the faded margin, towards the page's own column. The small
     station pictures in the waypoint cards are not nudged. */
  .dr-scene > .dr-svg {
    transform: translateX(calc(var(--bleed, 0px) * 0.25));
  }
  .dr-rail {
    position: sticky;
    top: 12px;
    flex: none;
    width: 96px;
    height: calc(100vh - 24px);
    display: flex;
    align-items: center;
  }
  .dr-rail-svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 88%;
    font-family: var(--mono);
  }
  .dr-rail-svg .r-star {
    fill: var(--text);
    opacity: 0.6;
  }
  .dr-rail-svg .r-moon {
    fill: color-mix(in srgb, var(--text) 85%, var(--bg));
  }
  .dr-rail-svg .r-plane {
    fill: color-mix(in srgb, var(--text) 70%, var(--bg));
    transform: translate(10px, 34px);
  }
  .dr-rail-svg .r-city {
    fill: color-mix(in srgb, var(--text) 7%, var(--bg));
  }
  .dr-rail-svg .r-roof {
    fill: color-mix(in srgb, var(--text) 22%, var(--surface));
  }
  .dr-rail-svg .r-bld {
    fill: color-mix(in srgb, var(--text) 4%, var(--surface));
    stroke: color-mix(in srgb, var(--text) 18%, transparent);
  }
  .dr-rail-svg .r-slab {
    fill: color-mix(in srgb, var(--text) 16%, var(--surface));
  }
  .dr-rail-svg .r-floor {
    fill: var(--muted);
    font-size: 7px;
    letter-spacing: 0.12em;
  }
  .dr-rail-svg .r-win {
    fill: color-mix(in srgb, var(--text) 10%, var(--bg));
  }
  .dr-rail-svg .r-win.lit {
    fill: color-mix(in srgb, var(--partial) 55%, var(--bg));
  }
  .dr-rail-svg .r-beam {
    opacity: 0.55;
    transition: opacity 300ms var(--ease);
  }
  .dr-rail-svg.is-beam .r-beam {
    opacity: 1;
  }
  .dr-rail-svg .r-pad {
    fill: color-mix(in srgb, var(--accent) 30%, var(--bg));
    stroke: var(--accent);
  }
  .dr-rail-svg .r-street {
    fill: color-mix(in srgb, var(--text) 8%, var(--bg));
  }
  .dr-rail-svg .r-lane {
    stroke: color-mix(in srgb, var(--partial) 60%, transparent);
    stroke-dasharray: 5 5;
  }
  .dr-rail-svg .r-track {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 25%, transparent);
    stroke-dasharray: 2 3;
  }
  .dr-rail-svg .r-fill {
    stroke: var(--accent);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .dr-rail-svg .r-node circle {
    fill: var(--bg);
    stroke: color-mix(in srgb, var(--text) 40%, transparent);
    stroke-width: 1.5;
    transition:
      fill var(--m-state) var(--ease),
      stroke var(--m-state) var(--ease);
  }
  .dr-rail-svg .r-node text {
    fill: var(--muted);
    font-size: 8px;
  }
  .dr-rail-svg .r-node.is-past circle {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .dr-rail-svg .r-node.is-here circle {
    fill: var(--partial);
    stroke: var(--partial);
  }
  .dr-rail-svg .r-node.is-here text {
    fill: var(--text);
  }
  .dr-rail-svg .r-halo {
    fill: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  /* The street around the building. */
  .dr-svg .ground {
    fill: color-mix(in srgb, var(--text) 4%, var(--bg));
  }
  .dr-svg .road {
    fill: color-mix(in srgb, var(--text) 2%, #0c0d0e);
  }
  .dr-svg .walk {
    fill: color-mix(in srgb, var(--text) 9%, var(--bg));
    stroke: color-mix(in srgb, var(--text) 16%, transparent);
  }
  .dr-svg .lane {
    fill: none;
    stroke: color-mix(in srgb, var(--partial) 55%, transparent);
    stroke-width: 1.4;
  }
  .dr-svg .zebra {
    fill: color-mix(in srgb, var(--text) 30%, transparent);
  }
  .dr-svg :is(.lpole, .trunk) {
    stroke: color-mix(in srgb, var(--text) 45%, var(--bg));
    stroke-width: 2;
  }
  .dr-svg .lhead {
    fill: var(--partial);
  }
  .dr-svg .pool {
    pointer-events: none;
  }
  .dr-svg .hl {
    fill: var(--text);
  }
  .dr-svg .beamh {
    fill: color-mix(in srgb, var(--text) 14%, transparent);
  }
  .dr-svg .tl {
    fill: var(--invalid);
  }
  .dr-floor {
    margin: 0 0 6px;
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .dr-hint {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-align: center;
  }
  .dr-intro {
    padding-bottom: 8px;
  }
  .dr-how {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }
  .dr-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dr-list .step {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px 0 32px 22px;
    border-left: 1px solid var(--rule);
    transition: border-color var(--m-state) var(--ease);
  }
  .droom.is-live .step:not(.is-active) :is(h4, .stext, .lede) {
    color: var(--muted);
  }
  .droom .step.is-active {
    border-left-color: var(--accent);
  }
  .snum {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .step h4 {
    margin: 0 0 10px;
    font: 400 clamp(1.6rem, 2.4vw, 2.1rem) / 1.12 var(--serif);
  }
  .step .lede {
    margin: 0 0 12px;
    font: italic 400 1.12rem / 1.5 var(--serif);
  }
  .stext {
    margin: 0 0 16px;
    font: 400 1.04rem / 1.65 var(--sans);
  }
  .dr-steps section + section {
    margin-top: 24px;
  }

  /* Beats: the words, facts and room notes for one beat light while that beat plays (--lit runs from 0 to 1). */
  .step .beat {
    padding: 1px 3px;
    margin: 0 -3px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--accent) calc(var(--lit) * 28%), transparent);
    box-shadow: inset 0 -1.5px 0 color-mix(in srgb, var(--accent) calc(40% + var(--lit) * 60%), transparent);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0 0 14px;
  }
  .fact {
    padding: 8px 10px;
    border: 1px solid color-mix(in srgb, var(--accent) calc(var(--lit) * 100%), var(--rule));
    background: color-mix(in srgb, var(--accent) calc(var(--lit) * 10%), transparent);
  }
  .fact dt {
    color: var(--muted);
    font: 400 11px var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .fact dd {
    margin: 4px 0 0;
    font: 500 0.95rem / 1.3 var(--sans);
  }
  @media (prefers-reduced-motion: no-preference) {
    .step.is-active .b1 {
      animation: dr-b1 6s infinite;
    }
    .step.is-active .b2 {
      animation: dr-b2 6s infinite;
    }
    .step.is-active .b3 {
      animation: dr-b3 6s infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step.is-active :is(.b1, .b2, .b3) {
      --lit: 1;
    }
  }
  @keyframes dr-b1 {
    0%,
    6%,
    97%,
    100% {
      --lit: 0;
    }
    10%,
    92% {
      --lit: 1;
    }
  }
  @keyframes dr-b2 {
    0%,
    34%,
    97%,
    100% {
      --lit: 0;
    }
    38%,
    92% {
      --lit: 1;
    }
  }
  @keyframes dr-b3 {
    0%,
    62%,
    97%,
    100% {
      --lit: 0;
    }
    66%,
    92% {
      --lit: 1;
    }
  }

  /* What a certificate covers: the exam's domains with their weights, or the program's topics. */
  .covers {
    margin: 0 0 14px;
  }
  .covers-h {
    margin: 0 0 8px;
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .covers ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .covers li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30% 34px;
    align-items: center;
    gap: 10px;
    font: 400 0.95rem / 1.35 var(--sans);
  }
  .covers li:not(:has(i)) {
    grid-template-columns: 1fr;
    padding-left: 14px;
    position: relative;
  }
  .covers li:not(:has(i))::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }
  .covers i {
    display: block;
    height: 8px;
    width: calc(var(--w) / 28 * 100%);
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0.15);
    opacity: 0.5;
    transition:
      transform 700ms var(--ease),
      opacity 700ms var(--ease);
  }
  .step.is-active .covers i,
  .droom:not(.is-live) .covers i {
    transform: scaleX(1);
    opacity: 1;
  }
  .covers b {
    color: var(--muted);
    font-size: 12px;
    font-weight: 400;
    text-align: right;
  }
  .covers-f {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }
  /* The page's own type for headings, dates, chips and certificates (its styles are scoped to the page). */
  .droom h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 18px;
    padding-top: 16px;
    border-top: 2px solid var(--accent);
    font: 500 12px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .droom h2 span {
    color: var(--accent);
  }
  .droom .etop {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 20px;
  }
  .droom .dr-intro h3 {
    margin: 0;
    font: 600 1.25rem / 1.25 var(--sans);
  }
  .droom .at {
    color: var(--muted);
    font-weight: 400;
  }
  .droom .edate {
    margin: 0;
    font: 500 var(--t-mono) var(--mono);
  }
  .droom .edate span {
    display: block;
    color: var(--muted);
    font-weight: 400;
  }
  .droom .esum {
    margin: 10px 0 0;
    color: var(--muted);
    font: 400 1.02rem / 1.55 var(--sans);
  }
  .droom .dr-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .droom .dr-chips li {
    padding: 3px 9px;
    border: 1px solid var(--rule);
    color: var(--muted);
    font: 400 12px var(--mono);
  }
  .droom .cert {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
  }
  .droom .cert h3 {
    margin: 0 0 6px;
    font: 400 clamp(1.4rem, 2.2vw, 1.8rem) / 1.15 var(--serif);
  }
  .droom .cert p {
    margin: 0 0 4px;
  }
  .droom .clogo {
    flex: none;
    width: 84px;
    height: 84px;
    object-fit: contain;
  }

  /* The room. Tones follow the Bench stages: a lit top, a mid front, a dark end, one accent. */
  .dr-svg :is(polygon, path, ellipse) {
    stroke-width: 0.8;
    stroke-linejoin: round;
  }
  .dr-svg :is(.n, .r, .fl) :is(.t, .f, .e) {
    stroke: color-mix(in srgb, var(--text) 30%, transparent);
  }
  .dr-svg .n .t {
    fill: color-mix(in srgb, var(--text) 16%, var(--surface));
  }
  .dr-svg .n .f {
    fill: color-mix(in srgb, var(--text) 9%, var(--surface));
  }
  .dr-svg .n .e {
    fill: color-mix(in srgb, var(--text) 4%, var(--surface));
  }
  /* Night City at home: purple-tinted walls, a dark glossy floor, magenta and cyan neon. */
  .dr-svg {
    --neon-m: #ff5fd2;
    --neon-c: #4fe3ff;
  }
  .dr-svg .r .t {
    fill: color-mix(in srgb, #5a4685 30%, var(--surface));
  }
  .dr-svg .r .f {
    fill: color-mix(in srgb, #2c2148 55%, var(--surface));
  }
  .dr-svg .r .e {
    fill: color-mix(in srgb, #221a3a 55%, var(--surface));
  }
  .dr-svg .fl .t {
    fill: color-mix(in srgb, #1c1630 65%, var(--bg));
  }
  .dr-svg .fl .f {
    fill: color-mix(in srgb, var(--text) 13%, var(--bg));
  }
  .dr-svg .fl .e {
    fill: color-mix(in srgb, var(--text) 8%, var(--bg));
  }
  .dr-svg :is(.l, .a) :is(.t, .f, .e, ellipse, path) {
    stroke: var(--bg);
  }
  .dr-svg .l :is(.t, ellipse) {
    fill: var(--text);
  }
  .dr-svg .l :is(.f, path) {
    fill: color-mix(in srgb, var(--text) 78%, var(--bg));
  }
  .dr-svg .l .e {
    fill: color-mix(in srgb, var(--text) 58%, var(--bg));
  }
  .dr-svg .a :is(.t, ellipse) {
    fill: var(--accent);
  }
  .dr-svg .a :is(.f, path) {
    fill: color-mix(in srgb, var(--accent) 72%, var(--bg));
  }
  .dr-svg .a .e {
    fill: color-mix(in srgb, var(--accent) 52%, var(--bg));
  }
  .dr-svg .w :is(.t, .f, .e, ellipse, path) {
    stroke: var(--accent);
    stroke-opacity: 0.8;
  }
  .dr-svg .w :is(.t, ellipse) {
    fill: color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .dr-svg .w :is(.f, path) {
    fill: color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .dr-svg .w .e {
    fill: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .dr-svg .k :is(.t, .f, .e, .m) {
    fill: var(--bg);
    stroke: color-mix(in srgb, var(--text) 40%, transparent);
  }
  .dr-svg .grid {
    fill: none;
    stroke: var(--text);
    stroke-opacity: 0.06;
  }
  .dr-svg .skirt {
    fill: color-mix(in srgb, var(--text) 14%, var(--surface));
  }
  .dr-svg .win {
    fill: color-mix(in srgb, var(--accent) 12%, var(--bg));
    stroke: color-mix(in srgb, var(--text) 40%, transparent);
  }
  .dr-svg .city {
    fill: color-mix(in srgb, var(--text) 10%, var(--bg));
  }
  .dr-svg :is(.lit, .star) {
    fill: var(--partial);
  }
  .dr-svg .star {
    fill: var(--text);
    opacity: 0.8;
  }
  .dr-svg .rug {
    fill: color-mix(in srgb, var(--accent) 10%, var(--bg));
    stroke: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .dr-svg .rug-in {
    fill: none;
    stroke: color-mix(in srgb, var(--accent) 30%, transparent);
    stroke-dasharray: 3 3;
  }
  .dr-svg .carpet {
    fill: color-mix(in srgb, var(--invalid) 34%, var(--bg));
    stroke: color-mix(in srgb, var(--partial) 50%, transparent);
  }
  .dr-svg .flag.a1 {
    fill: var(--accent);
  }
  .dr-svg .flag.a2 {
    fill: var(--partial);
  }
  .dr-svg .flag.a3 {
    fill: var(--verified);
  }
  .dr-svg .beam {
    opacity: 0.45;
    pointer-events: none;
    transition: opacity 300ms var(--ease);
  }
  .dr-svg.is-beam .beam {
    opacity: 1;
  }
  .dr-svg .pglow {
    fill: color-mix(in srgb, var(--accent) 22%, var(--bg));
    stroke: var(--accent);
  }
  .dr-svg .prune {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 7 5;
  }
  .dr-svg .pcore {
    fill: var(--accent);
    opacity: 0.7;
  }
  .dr-svg .mote {
    fill: var(--accent);
    opacity: 0;
  }
  .dr-svg .doormat {
    fill: color-mix(in srgb, var(--partial) 30%, var(--bg));
    stroke: color-mix(in srgb, var(--partial) 50%, transparent);
  }
  .dr-svg .leaf circle {
    fill: color-mix(in srgb, var(--verified) 55%, var(--bg));
    stroke: var(--bg);
  }
  .dr-svg :is(.cable, .rail, .pole, .rope, .tl, .pipe) {
    fill: none;
  }
  .dr-svg .cable {
    stroke: color-mix(in srgb, var(--accent) 40%, transparent);
    stroke-dasharray: 2 3;
  }
  .dr-svg :is(.rail, .pole) {
    stroke: color-mix(in srgb, var(--text) 55%, transparent);
    stroke-width: 1.6;
  }
  .dr-svg .rope {
    stroke: var(--invalid);
    stroke-width: 2;
  }
  .dr-svg .tl {
    stroke: color-mix(in srgb, var(--text) 30%, transparent);
  }
  .dr-svg .pipe {
    stroke: color-mix(in srgb, var(--text) 30%, transparent);
    stroke-dasharray: 2 2;
  }
  .dr-svg .clock circle {
    fill: var(--text);
    stroke: var(--bg);
  }
  .dr-svg .clock .hand {
    stroke: var(--bg);
    stroke-width: 1.4;
    transform-box: view-box;
    transform-origin: 0 0;
  }
  .dr-svg .sign {
    fill: var(--partial);
  }
  .dr-svg .sgn {
    fill: var(--bg);
    font-size: 8px;
    font-weight: 700;
  }
  .dr-svg .wt {
    fill: var(--muted);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .dr-svg .wn {
    fill: var(--text);
    font-size: 11px;
  }
  .dr-svg .wn.sm,
  .dr-svg .wt.sm {
    font-size: 10px;
  }
  .dr-svg .neon {
    fill: var(--neon-m);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    paint-order: stroke;
    stroke: color-mix(in srgb, var(--neon-m) 30%, transparent);
    stroke-width: 5px;
  }
  .dr-svg .ft {
    fill: color-mix(in srgb, var(--text) 30%, transparent);
    font-size: 18px;
    font-weight: 700;
  }
  .dr-svg .ft.sm {
    font-size: 8px;
    letter-spacing: 0.2em;
  }
  .dr-svg .stl.is-on .ft {
    fill: var(--accent);
  }
  .dr-svg .scr {
    fill: var(--neon-c);
    font-size: 9px;
  }
  .dr-svg .bt {
    fill: var(--bg);
    font-size: 11px;
    font-weight: 700;
  }
  .dr-svg .bt.sm {
    font-size: 10px;
    font-weight: 400;
  }
  .dr-svg .bt.hit {
    fill: var(--verified);
    opacity: 0;
  }
  .dr-svg .nt {
    fill: var(--bg);
    font-size: 7.5px;
  }
  .dr-svg .plq {
    fill: var(--muted);
    font-size: 6.5px;
    letter-spacing: 0.06em;
  }
  .dr-svg .board {
    fill: color-mix(in srgb, var(--text) 86%, var(--bg));
  }
  .dr-svg .chalk {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
  }
  .dr-svg .note {
    fill: var(--partial);
  }
  .dr-svg .frame {
    fill: color-mix(in srgb, var(--text) 20%, var(--surface));
    stroke: color-mix(in srgb, var(--text) 40%, transparent);
  }
  .dr-svg .disp {
    fill: var(--bg);
    stroke: color-mix(in srgb, var(--text) 40%, transparent);
  }
  .dr-svg .dt {
    fill: var(--muted);
    font-size: 10px;
  }
  .dr-svg .dn {
    fill: var(--partial);
    font-size: 10px;
    font-weight: 700;
  }
  .dr-svg .dn.n15 {
    fill: var(--verified);
    opacity: 0;
  }
  .dr-svg .belt {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 30%, transparent);
    stroke-dasharray: 3 3;
  }
  .dr-svg .stick {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
  }
  .dr-svg .knob {
    fill: var(--invalid);
  }
  .dr-svg .ttl {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 72;
    opacity: 0;
  }
  .dr-svg .orb circle {
    fill: color-mix(in srgb, var(--accent) 35%, var(--bg));
    stroke: var(--accent);
  }
  .dr-svg .orb.o2 circle {
    fill: color-mix(in srgb, var(--verified) 35%, var(--bg));
    stroke: var(--verified);
  }
  .dr-svg .orb text {
    fill: var(--text);
    font-size: 10px;
  }
  .dr-svg .orb circle {
    opacity: 0.45;
  }
  .dr-svg .st.is-on .orb circle {
    opacity: 1;
  }

  /* Outside: the city, the sky, and what moves in it. */
  .dr-svg .city :is(.t, .f, .e) {
    stroke: color-mix(in srgb, var(--text) 10%, transparent);
  }
  .dr-svg .city .t {
    fill: color-mix(in srgb, var(--text) 9%, var(--bg));
  }
  .dr-svg .city .f {
    fill: color-mix(in srgb, var(--text) 6%, var(--bg));
  }
  .dr-svg .city .e {
    fill: color-mix(in srgb, var(--text) 3.5%, var(--bg));
  }
  /* The building's own bulk, so the city never shows through a faded floor. */
  .dr-svg .mass :is(.t, .f, .e) {
    fill: var(--bg);
    stroke: none;
  }
  .dr-svg .bw {
    fill: color-mix(in srgb, var(--partial) 38%, var(--bg));
    stroke: none;
  }
  .dr-svg :is(.ant, .wire) {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 25%, transparent);
  }
  .dr-svg .beacon {
    fill: var(--invalid);
  }
  .dr-svg .sky-star {
    fill: var(--text);
    opacity: 0.55;
  }
  .dr-svg .moon circle {
    fill: color-mix(in srgb, var(--text) 88%, var(--bg));
  }
  .dr-svg .moon .crater {
    fill: color-mix(in srgb, var(--text) 70%, var(--bg));
  }
  .dr-svg .plane {
