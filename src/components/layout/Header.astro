---
import NavLinks from '../navigation/NavLinks.astro';
import { site } from '../../data/site.ts';
---

<header class="top">
  <div class="wrap bar">
    <a class="mark" href="/" style="color: var(--accent)">
      {site.name}
    </a>
    <nav class="desktop" aria-label="Primary">
      <NavLinks />
    </nav>
    <button class="notes-toggle" type="button" aria-pressed="true" data-notes-toggle>
      <span class="nt-dot" aria-hidden="true"></span>
      <span class="nt-label">Hand notes: on</span>
    </button>
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Primary (menu)">
        <NavLinks />
      </nav>
    </details>
  </div>
</header>
<!-- The same switch as a floating pop-up, shown once the visitor has scrolled past the opening while the navbar is
     away. It is a visual duplicate (the navbar button is the accessible control), so it is hidden from assistive
     technology. It sits outside the header because the header is transformed when it dissolves, and a transformed
     ancestor would stop `position: fixed` from meaning the viewport. -->
<button
  class="notes-toggle float"
  type="button"
  aria-hidden="true"
  tabindex="-1"
  data-notes-toggle
  data-float
>
  <span class="nt-dot" aria-hidden="true"></span>
  <span class="nt-label">Hand notes: on</span>
</button>

<script>
  // The magic line: one thin line under the desktop links. It follows the pointer (or keyboard focus) from link to
  // link, stretching as it goes, and settles back under the current page when the pointer leaves.
  {
    const nav = document.querySelector<HTMLElement>('nav.desktop');
    const links = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('li > a:not(.util)')] : [];
    if (nav && links.length) {
      const line = document.createElement('span');
      line.className = 'magic-line';
      line.setAttribute('aria-hidden', 'true');
      nav.append(line);
      const current = links.find((a) => a.getAttribute('aria-current') === 'page') ?? null;
      const go = (a: HTMLAnchorElement | null) => {
        if (!a) {
          line.style.opacity = '0';
          return;
        }
        const r = a.getBoundingClientRect();
        const n = nav.getBoundingClientRect();
        line.style.opacity = '1';
        line.style.width = `${r.width}px`;
        line.style.transform = `translate(${r.left - n.left}px, ${r.bottom - n.top - 2}px)`;
      };
      const settle = () => go(current);
      // The first placement happens without travelling there from the corner.
      line.style.transition = 'none';
      settle();
      requestAnimationFrame(() => requestAnimationFrame(() => (line.style.transition = '')));
      for (const a of links) {
        a.addEventListener('pointerenter', () => go(a));
        a.addEventListener('focus', () => go(a));
        a.addEventListener('blur', settle);
      }
      nav.addEventListener('pointerleave', settle);
      addEventListener('resize', settle);
      if (document.fonts) document.fonts.ready.then(settle);
    }
  }
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-notes-toggle]')];
  const root = document.documentElement;
  let stored: string | null = null;
  try {
    stored = localStorage.getItem('notes');
    if (localStorage.getItem('notes-seen')) root.dataset.notesSeen = '1';
  } catch {
    /* storage unavailable: notes stay on */
  }
  const apply = (on: boolean) => {
    root.dataset.notes = on ? 'on' : 'off';
    for (const toggle of toggles) {
      toggle.setAttribute('aria-pressed', String(on));
      const label = toggle.querySelector('.nt-label');
      if (label) label.textContent = on ? 'Hand notes: on' : 'Hand notes: off';
    }
    root.dispatchEvent(new Event('notes-toggle'));
  };
  apply(stored !== 'off');
  for (const toggle of toggles)
    toggle.addEventListener('click', () => {
      root.dataset.notesSeen = '1';
      const next = root.dataset.notes === 'off';
      apply(next);
      try {
        localStorage.setItem('notes-seen', '1');
        localStorage.setItem('notes', next ? 'on' : 'off');
      } catch {
        /* storage unavailable */
      }
    });

  // Pages with no annotations have nothing to switch.
  if (!document.querySelector('.note')) root.dataset.noNotes = '1';

  // The pop-up appears once the opening section has scrolled out of view (or after a short scroll on other pages).
  const hero = document.querySelector<HTMLElement>('.hero');
  let frame = 0;
  let lastY = window.scrollY;
  const menu = document.querySelector<HTMLDetailsElement>('details.menu');
  // The hero boundary is measured when the hero changes size, not on every scroll frame, and the root attributes are
  // written only when they change, so scrolling past the opening does not force layout or invalidate styles.
  let limit = 360;
  const measure = () => {
    limit = hero ? hero.offsetTop + hero.offsetHeight - 120 : 360;
  };
  const setFlag = (name: 'pastHero' | 'nav', value: string | null) => {
    if ((root.dataset[name] ?? null) === value) return;
    if (value === null) delete root.dataset[name];
    else root.dataset[name] = value;
  };
  const update = () => {
    frame = 0;
    const y = window.scrollY;
    setFlag('pastHero', y > limit ? '1' : null);
    // The navbar stays put through the opening. Below it, it dissolves while the visitor reads down and returns
    // on the first upward scroll, so there is never a trip back to the top just to reach it.
    const delta = y - lastY;
    if (Math.abs(delta) > 6) {
      lastY = y;
      // Keyboard focus that scrolls the page up must not bring the navbar back over the control that was just focused.
      const held = performance.now() < focusHold;
      setFlag('nav', y <= limit || (delta < 0 && !held) || menu?.open ? null : 'hidden');
    }
  };
  let focusHold = 0;
  document.addEventListener('focusin', (event) => {
    const target = event.target as Element;
    if (target.closest('header.top') || !root.dataset.pastHero || !target.matches(':focus-visible')) return;
    focusHold = performance.now() + 500;
    setFlag('nav', 'hidden');
  });
  measure();
  if (hero && 'ResizeObserver' in window) new ResizeObserver(measure).observe(hero);
  window.addEventListener('resize', measure);
  window.addEventListener('load', measure);
  // Opening the menu or focusing a link in the bar always brings it back.
  menu?.addEventListener('toggle', () => {
    if (menu.open) delete root.dataset.nav;
  });
  document.querySelector('header.top')?.addEventListener('focusin', () => delete root.dataset.nav);
  window.addEventListener(
    'scroll',
    () => {
      if (!frame) frame = requestAnimationFrame(update);
    },
    { passive: true },
  );
  update();
</script>
<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }
  @media (prefers-reduced-motion: no-preference) {
    .top {
      transition:
        transform 260ms var(--ease),
        opacity 220ms var(--ease);
    }
  }
  /* A phone on its side has no height to spare: the bar scrolls away with the page instead of covering the content. */
  @media (max-height: 500px) {
    .top {
      position: static;
    }
  }
  /* Scrolling down below the opening: the bar dissolves upward. Reduced motion gets an instant swap. */
  :global(html[data-nav='hidden']) .top {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }
  :global(html[data-past-hero]) .top {
    box-shadow: 0 10px 24px -18px #000;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: 1.5rem;
  }
  .mark {
    font: 700 1.25rem / 1 var(--serif);
    text-decoration: none;
  }
  .menu {
    display: none;
  }
  .desktop {
    margin-left: auto;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-weight: 500;
    padding: 0 0.2rem;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu[open] {
    flex-basis: 100%;
  }
  .menu :global(ul) {
    display: grid;
    gap: 0;
    padding: 0.5rem 0 1rem;
  }
  .menu :global(li > a),
  .menu :global(li > span) {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .menu :global(a.util) {
    border: 0;
    padding: 0.85rem 0;
    font: 400 var(--t-ui) var(--sans);
    color: var(--text);
  }
  /* The editorial links: each word rolls up into an italic accent copy on hover or focus, and the magic line
     (see the script) replaces the plain underline. */
  .desktop {
    position: relative;
  }
  .desktop :global(a[aria-current='page']),
  .desktop :global(li > a:not(.util):hover) {
    border-bottom-color: transparent;
  }
  .desktop :global(.roll) {
    display: inline-block;
    height: 1.5em;
    overflow: hidden;
    line-height: 1.5;
    vertical-align: bottom;
    /* Room for the italic copy's overhang, so its last letter is not clipped. */
    padding-right: 0.15em;
    margin-right: -0.15em;
  }
  .desktop :global(.roll > span) {
    display: block;
  }
  .desktop :global(.roll > span::after) {
    /* The alternative text after the slash keeps this copy out of what a screen reader says. */
    content: attr(data-t) / '';
    display: block;
    color: var(--accent);
    font-style: italic;
  }
  .desktop :global(.magic-line) {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    border-radius: 2px;
    background: var(--accent);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .desktop :global(.roll > span) {
      transition: transform 450ms var(--ease);
    }
    .desktop :global(.magic-line) {
      transition:
        transform 500ms var(--ease),
        width 500ms var(--ease),
        opacity 200ms var(--ease);
    }
  }
  .desktop :global(a:hover .roll > span),
  .desktop :global(a:focus-visible .roll > span) {
    transform: translateY(-50%);
  }
  @media (max-width: 900px) {
    .desktop {
      display: none;
    }
    .menu {
      display: block;
    }
    .bar {
      flex-wrap: wrap;
    }
  }
</style>
