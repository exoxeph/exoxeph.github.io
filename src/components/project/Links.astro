---
const project = Astro.locals.project;
if (!project) throw new Error('<Links /> must render inside a project page');
---

<ul class="links">
  {project.data.links.map((l) => (
    <li>
      <a href={l.url} rel="noopener">
        {l.label}
      </a>
    </li>
  ))}
  <li class="muted">No hosted demo.</li>
</ul>

<style>
  .links {
    list-style: none;
    padding: 0 !important;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
</style>
