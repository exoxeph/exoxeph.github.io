---
import Mechanism from '../diagrams/Mechanism.astro';
interface Props {
  caption: string;
}
const project = Astro.locals.project;
if (!project) throw new Error('<ProjectDiagram /> must render inside a project page');
const { caption } = Astro.props;
---

<div class="plate">
  <Mechanism name={project.data.diagram} id={`dg-case-${project.id}`} caption={caption} />
</div>

<style>
  .plate {
    max-width: 560px;
    margin: 0 0 1.6rem;
    border-top: 2px solid var(--rule-strong);
    padding-top: 1rem;
  }
</style>
