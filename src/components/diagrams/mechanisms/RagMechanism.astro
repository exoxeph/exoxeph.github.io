---
const { id } = Astro.props;
---

<svg class="dg mech-svg" viewBox="0 0 280 100" role="img" aria-labelledby={`${id}-t ${id}-d`}>
  <title id={`${id}-t`}>Verify and repair step</title>
  <desc id={`${id}-d`}>
    A verify score at or above the threshold skips repair and returns the answer. A lower score sends the run
    back through retrieval for one repair attempt. After that the answer is returned either way, marked not
    accepted if the score is still below the threshold.
  </desc>
  <text class="t" x="4" y="14">
    plan
  </text>
  <text class="t" x="84" y="14">
    retrieve
  </text>
  <text class="t" x="156" y="14">
    verify
  </text>
  <text class="t" x="228" y="14">
    answer
  </text>
  <rect class="ln" x="4" y="32" width="40" height="20" />
  <path class="ln" d="M44 42H84" />
  <rect class="ln" x="84" y="32" width="50" height="20" />
  <path class="ln" d="M134 42H164" />
  <path class="ln rag-verify" d="M176 30L188 42L176 54L164 42Z" />
  <path class="ln" d="M188 42H228" />
  <rect class="ln" x="228" y="32" width="48" height="20" />
  <g class="b rag-repair">
    <path class="ac draw" d="M176 54C176 86 109 86 109 54M105 59L109 54L113 59" />
    <text class="t ac" x="142" y="96" text-anchor="middle">
      repair
    </text>
  </g>
</svg>
