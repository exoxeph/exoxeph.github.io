---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<svg
  class="dg"
  viewBox="0 0 280 100"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby={`${id}-t ${id}-d`}
>
  <title id={`${id}-t`}>Capacity guard on a shared vehicle</title>
  <desc id={`${id}-d`}>
    Three seats are committed on a vehicle with capacity 3. A request for two more seats is refused at the
    capacity line with HTTP 409.
  </desc>
  <text class="t" x="4" y="14">
    seats committed: 3 of 3
  </text>
  <rect class="s1" x="4" y="26" width="28" height="28" />
  <rect class="s2" x="36" y="26" width="28" height="28" />
  <rect class="s2" x="68" y="26" width="28" height="28" />
  <path class="th" d="M102 20V62" />
  <rect class="rq" x="172" y="26" width="84" height="28" />
  <text class="t hi" x="214" y="44" text-anchor="middle">
    request C
  </text>
  <path class="ac" d="M174 40H114M119 36L114 40L119 44" />
  <path class="bar" d="M104 30V50" />
  <text class="t hi" x="4" y="84">
    guard refuses: HTTP 409
  </text>
</svg>
