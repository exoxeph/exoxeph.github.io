---
// The first page of the home storybook: who I am and the one idea, drawn. The next page is the Bench.
import { site } from '../../data/site.ts';
import Portrait from '../portrait/Portrait.astro';
import Note from '../notes/Note.astro';
---

<section id="story-open" class="story-page story-full hero" aria-labelledby="hero-h">
  <div class="wrap open-grid">
    <div class="open-id">
      <div class="hero-who">
        <Portrait size={140} loading="eager" />
        <p class="who">
          AI Engineer at Data Solution-360
          <br />
          Computer Science, BRAC University
          <br />
          Dhaka, Bangladesh
        </p>
      </div>
      <h1 id="hero-h">
        <span class="name">{site.name}</span>
        <span class="role">{site.role}</span>
      </h1>
      <p class="lede">{site.lede}</p>
    </div>

    <figure class="idea">
      <div class="notes-layer">
        <Note cls="margin" t="a request comes in" to=".idea-req" at="tc" dx={-20} dy={-58} r={-3} />
        <Note
          cls="margin"
          t="the check sits in its path"
          to=".idea-gate"
          at="bc"
          dx={-40}
          dy={64}
          r={2}
          w="130px"
        />
        <Note
          cls="margin"
          t="it acts only if the check passes"
          to=".idea-act"
          at="tc"
          dx={10}
          dy={-60}
          r={-2}
          w="140px"
        />
      </div>
      <svg
        class="idea-svg"
        viewBox="0 0 520 170"
        role="img"
        aria-label="A request goes into a check. If it passes, the system acts. If it does not, the system stops: it asks, refuses or leaves the value out."
      >
        <g class="idea-req">
          <rect x="4" y="62" width="112" height="44"></rect>
          <text x="60" y="89">
            a request
          </text>
        </g>
        <path class="idea-wire" d="M116 84H196" pathLength="1"></path>
        <g class="idea-gate">
          <path d="M226 54l30 30-30 30-30-30z"></path>
          <circle cx="226" cy="84" r="5"></circle>
          <text x="226" y="136">
            check
          </text>
        </g>
        <path class="idea-wire pass" d="M256 84h36V34h44" pathLength="1"></path>
        <path class="idea-wire stop" d="M256 84h36v50h44"></path>
        <g class="idea-act">
          <rect x="336" y="12" width="180" height="44"></rect>
          <text x="426" y="39">
            the system acts
          </text>
        </g>
        <g class="idea-halt">
          <rect x="336" y="112" width="180" height="44"></rect>
          <text x="426" y="139">
            ask, refuse, leave out
          </text>
        </g>
        <text class="idea-flag pass" x="292" y="24">
          passes
        </text>
        <text class="idea-flag stop" x="292" y="154">
          fails
        </text>
      </svg>
      <figcaption class="idea-cap">Check before acting.</figcaption>
    </figure>

    <p class="turn" aria-hidden="true">
      <span>Four systems, one idea</span>
      <span>scroll to turn the page</span>
    </p>
  </div>
</section>

<style is:global>
  /* Opening and promise pages fill the screen from its top edge (the chapter pages start under a sticky identity). */
  .story .story-full {
    display: flex;
    align-items: center;
    min-height: 100svh;
    scroll-margin-top: 0;
    border-bottom: 1px solid var(--rule);
  }
  .story .story-full > .wrap {
    width: 100%;
  }
  /* The first page sits under the bar and snaps to the very top of the document, so the bar stays in view. */
  .story #story-open {
    min-height: calc(100svh - var(--bar-h, 65px));
    /* its snap position is the very top of the document, so the bar stays in view */
    scroll-margin-top: var(--bar-h, 65px);
  }
  .open-grid {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 24px clamp(32px, 5vw, 88px);
    padding-block: clamp(28px, 6vh, 64px) clamp(64px, 10vh, 96px);
  }
  .hero-who {
    display: flex;
    align-items: center;
    gap: 26px;
    margin: 0 0 clamp(22px, 3.6vh, 36px) 11px;
  }
  .hero-who .who {
    margin: 0;
    color: var(--muted);
    font: 400 12px / 1.7 var(--mono);
    letter-spacing: 0.04em;
  }
  .open-id h1 {
    margin: 0;
    font: 400 clamp(3.1rem, 5.5vw, 5.3rem) / 0.98 var(--serif);
    letter-spacing: -0.02em;
  }
  .open-id .name,
  .open-id .role {
    display: block;
  }
  .open-id .role {
    margin: 0.22em 0 0;
    color: var(--accent);
    font-style: italic;
  }
  .open-id .lede {
    max-width: 30ch;
    margin: clamp(18px, 3vh, 30px) 0 0;
    color: var(--muted);
    font: 400 clamp(1.1rem, 1.5vw, 1.35rem) / 1.4 var(--serif);
  }

  /* The idea, drawn: a request, a check in its path, two ways out. */
  .idea {
    position: relative;
    margin: 0;
  }
  .idea-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .idea-svg rect,
  .idea-gate path {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 1;
  }
  .idea-gate path {
    stroke: var(--accent);
  }
  .idea-gate circle {
    fill: var(--accent);
  }
  .idea-act rect {
    stroke: var(--verified);
  }
  .idea-halt rect {
    stroke: var(--invalid);
    stroke-dasharray: 4 3;
  }
  .idea-wire {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1;
  }
  .idea-wire.pass {
    stroke: var(--verified);
  }
  .idea-wire.stop {
    stroke: var(--invalid);
    stroke-dasharray: 4 3;
  }
  .idea-svg text {
    fill: var(--text);
    font: 400 13px var(--mono);
    text-anchor: middle;
  }
  .idea-gate text {
    fill: var(--accent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .idea-svg .idea-flag {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-anchor: start;
    text-transform: uppercase;
  }
  .idea-flag.pass {
    fill: var(--verified);
  }
  .idea-flag.stop {
    fill: var(--invalid);
  }
  .idea-cap {
    margin-top: 22px;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    color: var(--text);
    font: 400 clamp(1.3rem, 1.9vw, 1.6rem) / 1.3 var(--serif);
  }
  .turn {
    position: absolute;
    right: var(--pad);
    bottom: 18px;
    left: var(--pad);
    display: flex;
    justify-content: space-between;
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font: 400 11px var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* The idea draws itself once, on arrival: the request, then the check, then the two ways out, the wires tracing
     between them. */
  @media (prefers-reduced-motion: no-preference) {
    .idea-svg :is(.idea-req, .idea-gate, .idea-act, .idea-halt, .idea-flag) {
      animation: idea-in 700ms var(--ease-soft) both;
    }
    .idea-svg .idea-gate {
      animation-delay: 260ms;
    }
    .idea-svg :is(.idea-act, .idea-flag.pass) {
      animation-delay: 620ms;
    }
    .idea-svg :is(.idea-halt, .idea-flag.stop) {
      animation-delay: 760ms;
    }
    .idea-wire:not(.stop) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: idea-wire 620ms var(--ease-soft) 180ms forwards;
    }
    .idea-wire.pass {
      animation-delay: 480ms;
    }
    .idea-wire.stop {
      animation: idea-fade 620ms var(--ease-soft) 560ms both;
    }
    .idea-cap {
      animation: idea-in 800ms var(--ease-soft) 900ms both;
    }
  }
  @keyframes idea-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes idea-wire {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes idea-fade {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 899px) {
    .open-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      padding-block: 18px 64px;
    }
    .open-id h1 {
      font-size: clamp(2.1rem, 10.4vw, 3.6rem);
    }
    .open-id .role {
      margin-top: 0.12em;
    }
    .hero .portrait {
      --p: 92px !important;
    }
    .hero-who {
      gap: 20px;
      margin: 0 0 18px;
    }
    .hero-who .who {
      font-size: 10.5px;
      line-height: 1.65;
      letter-spacing: 0;
    }
    .open-id .lede {
      max-width: 34ch;
      margin-top: 14px;
      font-size: 1.12rem;
    }
    .idea .notes-layer {
      display: none;
    }
  }
  /* A phone on its side: a smaller portrait, name and role on one line. */
  @media (max-width: 899px) and (max-height: 500px) {
    .hero .portrait {
      --p: 64px !important;
    }
    .open-id h1 {
      font-size: clamp(1.7rem, 5.4vw, 2.4rem);
    }
    .open-id .name,
    .open-id .role {
      display: inline;
    }
    .open-id .role {
      margin-left: 0.3em;
    }
  }
</style>
