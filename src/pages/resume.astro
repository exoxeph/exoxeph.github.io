---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.ts';
import Portrait from '../components/portrait/Portrait.astro';
import DevRoom from '../components/resume/DevRoom.astro';

// Content comes from my CV. Phone number and street address are deliberately not published here.
const contact = {
  place: 'Dhaka, Bangladesh',
  email: site.links.email!,
  linkedin: site.links.linkedin!,
  github: site.links.github,
};

const skills = [
  {
    group: 'Machine learning and NLP',
    items: [
      'Python',
      'PyTorch',
      'scikit-learn',
      'Pandas',
      'NumPy',
      'Hugging Face Transformers',
      'NLP',
      'Model training',
      'Model evaluation',
    ],
  },
  {
    group: 'Generative AI and retrieval',
    items: [
      'LLMs',
      'RAG',
      'Embeddings',
      'BM25',
      'Vector search',
      'Hybrid retrieval',
      'Weighted fusion',
      'Pinecone',
    ],
  },
  {
    group: 'Backend and data',
    items: ['FastAPI', 'REST APIs', 'MongoDB', 'SQLite', 'Redis', 'DuckDB', 'Node.js'],
  },
  {
    group: 'AI infrastructure and cloud',
    items: [
      'Docker',
      'Docker Compose',
      'CI/CD',
      'GitHub Actions',
      'GitHub Container Registry',
      'DigitalOcean',
      'AWS',
      'Git',
      'Linux',
    ],
  },
];

const work = {
  role: 'AI Engineer',
  org: 'Data Solution-360',
  dates: 'Jan 2026 to Present',
  place: 'Dhaka, Bangladesh',
  summary:
    'Worked on Linx360.com, an AI-powered interview and assessment platform that identifies skill gaps, delivers role-aligned interview practice, and helps candidates become job-ready.',
  // Each point: where the mascot works on it, a line of context, the CV text with its three beats marked [[n:...]],
  // the facts in it, and the live readout that plays beside it. Without the marks, the text reads exactly as the CV does.
  points: [
    {
      id: 'rs-questions',
      place: 'At the desk',
      title: 'Fifteen questions, in parallel',
      lede: 'Every candidate on Linx360 gets an assessment built from their own profile and skill gaps, so the questions are generated on demand.',
      text: 'Built a Python/FastAPI MCQ assessment pipeline with OpenAI API, generating [[1:15 personalized questions]] from candidate profiles and skill gaps; [[2:parallelized requests with Redis TTL storage]], cutting latency from about [[3:10 to 15 s down to about 2 to 5 s]].',
      facts: [
        ['Questions', '15 per assessment', 1],
        ['Storage', 'Redis, with TTL', 2],
        ['Latency', 'about 10 to 15 s → about 2 to 5 s', 3],
      ],
      pulse: 'latency',
      stack: ['Python', 'FastAPI', 'OpenAI API', 'Redis'],
    },
    {
      id: 'rs-critic',
      place: 'At the conveyor',
      title: 'A critic that sends questions back',
      lede: 'A generated question can come back malformed or pitched at the wrong level, so every one is checked before a candidate sees it.',
      text: 'Built an LLM [[1:critic/regeneration loop]] with [[2:strict JSON schemas and Bloom-aligned rubrics]], regenerating rejected questions [[3:until all 15 passed validation]].',
      facts: [
        ['Check', 'strict JSON schema', 2],
        ['Rubric', 'Bloom-aligned', 2],
        ['Exit rule', 'all 15 pass', 3],
      ],
      pulse: 'critic',
      stack: ['OpenAI API', 'JSON schemas', 'Bloom rubrics'],
    },
    {
      id: 'rs-ranking',
      place: 'At the whiteboard',
      title: 'Ranking about 30K records',
      lede: 'A ranking is only worth what its evaluation is worth, so the targets avoid leakage and the score comes from data the model never saw.',
      text: 'Engineered a scikit-learn ranking/scoring workflow over [[1:about 30K records]] using Pandas/NumPy for feature engineering, [[2:leakage-safe proxy targets]], and [[3:held-out evaluation with Precision@50]].',
      facts: [
        ['Records', 'about 30K', 1],
        ['Targets', 'leakage-safe proxies', 2],
        ['Metric', 'Precision@50, held out', 3],
      ],
      pulse: 'rank',
      stack: ['scikit-learn', 'Pandas', 'NumPy'],
    },
    {
      id: 'rs-deploy',
      place: 'Between the rack and the cloud',
      title: 'Shipping the services to the cloud',
      lede: 'The services ran in Docker on a Linux host. Moving them meant a release that builds, publishes and deploys on its own.',
      text: 'Migrated [[1:Docker services from Linux]] to [[3:DigitalOcean App Platform]] with [[2:automated GitHub Actions and GHCR CI/CD]].',
      facts: [
        ['From', 'Docker on Linux', 1],
        ['Pipeline', 'GitHub Actions → GHCR', 2],
        ['To', 'DigitalOcean App Platform', 3],
      ],
      pulse: 'ship',
      stack: ['Docker', 'GitHub Actions', 'GHCR', 'DigitalOcean'],
    },
    {
      id: 'rs-agents',
      place: 'At the standing desk',
      title: 'Agents, with the tests written first',
      lede: 'Two coding agents, one workflow: plan, implement, debug and validate, with the tests written first.',
      text: 'Used [[2:Claude Code and Codex with MCP, Superpowers]], and [[3:pytest TDD]] to [[1:plan]], [[2:implement, debug]], and [[3:validate features end to end]].',
      facts: [
        ['Agents', 'Claude Code, Codex', 2],
        ['Tooling', 'MCP, Superpowers', 2],
        ['Method', 'pytest TDD', 3],
      ],
      pulse: 'tdd',
      stack: ['Claude Code', 'OpenAI Codex', 'MCP', 'Superpowers', 'pytest'],
    },
  ],
  stack: [
    'Python',
    'FastAPI',
    'OpenAI API',
    'Pandas',
    'NumPy',
    'scikit-learn',
    'Redis',
    'Docker',
    'GitHub Actions',
    'GHCR',
    'DigitalOcean',
    'pytest',
    'Claude Code',
    'OpenAI Codex',
    'MCP',
    'Superpowers',
  ],
};

const projects = [
  {
    title: 'Data-Aware RAG System for Research Papers',
    line: 'Local multi-paper research assistant with hybrid retrieval and source/page citations.',
    points: [
      'Built Python PDF ingestion with Marker and pdfplumber, using page-aware chunking to preserve source and page metadata.',
      'Generated local all-MiniLM-L6-v2 embeddings with Sentence Transformers and combined dense cosine search with BM25 using normalized weighted fusion.',
      'Decomposed multi-paper questions into atomic needs, then rewrote and routed queries to retrieve evidence from relevant papers.',
      'Generated citation-aware answers locally with Ollama, propagating retrieved paper and page metadata into responses.',
      'Parallelized LLM query classification, reducing an eight-query experiment from 70.6 s to 20.3 s with the same 26/35 score.',
    ],
    stack: [
      'Python',
      'Sentence Transformers',
      'all-MiniLM-L6-v2',
      'BM25',
      'NumPy',
      'Marker',
      'pdfplumber',
      'SQLite',
      'Streamlit',
      'Ollama',
    ],
    case: { href: '/work/retrieval-orchestration/', label: 'Read the case study on this site' },
  },
  {
    title: 'ClientManager Pro: AI-Powered Client Management System',
    line: 'Full-stack client platform with project workflows, real-time communication, and AI-powered repository Q&A.',
    points: [
      'Built Next.js frontend and Express/Node.js REST APIs with MongoDB persistence for client and project workflows.',
      'Implemented JWT authentication and role-based access control across multiple user roles and protected routes.',
      'Built GitHub repository Q&A with Transformers.js and all-MiniLM-L6-v2, storing embeddings in Pinecone and answering retrieved-context questions with Gemini.',
      'Reduced repeated AI computation with embedding/answer caching and query deduplication, avoiding unnecessary embedding and generation calls.',
      'Implemented Socket.IO real-time chat alongside project workflows and automated document generation.',
    ],
    stack: [
      'Next.js',
      'Node.js',
      'Express',
      'MongoDB',
      'JWT',
      'Socket.IO',
      'Pinecone',
      'Transformers.js',
      'all-MiniLM-L6-v2',
      'Gemini',
    ],
    case: null,
  },
];

const certs = [
  {
    id: 'rs-aws',
    name: 'AWS Certified AI Practitioner',
    by: 'Amazon Web Services (AWS)',
    when: 'Issued Sep 2026, expires Sep 2029',
    href: 'https://www.credly.com/badges/f877a355-f105-4953-9784-0ebedbeda19e/linked_in_profile',
    link: 'View credential',
    logo: '/certs/aws-ai-practitioner.webp',
    logoAlt: 'AWS Certified AI Practitioner badge',
    place: 'Upstairs, by the fireplace',
    lede: 'A foundational AWS certification: explaining AI, machine learning and generative AI, and choosing and using them responsibly on AWS.',
    // The exam's five domains and their weights, from the AIF-C01 exam guide.
    covers: [
      ['Fundamentals of AI and ML', 20],
      ['Fundamentals of generative AI', 24],
      ['Applications of foundation models', 28],
      ['Guidelines for responsible AI', 14],
      ['Security, compliance and governance for AI', 14],
    ],
    format: 'Exam AIF-C01 · 65 questions · 90 minutes · pass mark 700 of 1,000',
    facts: [
      ['Issuer', 'Amazon Web Services', 1],
      ['Issued', 'Sep 2026', 2],
      ['Valid until', 'Sep 2029', 3],
    ],
    pulse: 'valid',
  },
  {
    id: 'rs-udacity',
    name: 'Future AWS Agent Engineer Nanodegree',
    by: 'Udacity',
    when: 'Completed Oct 2026',
    href: 'https://www.udacity.com/certificate/e/be79146e-900d-11f1-84b6-df558e132a0d',
    link: 'View certificate',
    logo: '/certs/udacity.webp',
    logoAlt: 'Udacity logo',
    place: 'Upstairs, at the trophy case',
    lede: 'One of the Nanodegree tracks of the AWS AI & ML Scholars program: building AI agents on AWS, from the first prompt to deployment.',
    covers: [
      ['Prompting and agentic workflow patterns'],
      ['Amazon Bedrock and the Bedrock API'],
      ['Multi-agent systems with the Strands Agents SDK'],
      ['Running agents on Amazon Bedrock AgentCore'],
      ['Secure, observable agents in production'],
    ],
    format: 'Udacity Nanodegree · AWS AI & ML Scholars · completed Oct 2026',
    facts: [
      ['Provider', 'Udacity', 1],
      ['Program', 'Nanodegree', 2],
      ['Completed', 'Oct 2026', 3],
    ],
    pulse: 'done',
  },
  {
    id: 'rs-redis',
    name: 'Redis Certified: Associate Developer',
    by: 'Redis',
    when: 'Issued Oct 2026, expires Oct 2028',
    href: 'https://credentials.redis.io/9db642ab-2b59-46db-8a85-e6ec3a36a18a',
    link: 'View credential',
    logo: '/certs/redis.webp',
    logoAlt: 'Redis Certified Associate Developer badge',
    place: 'Upstairs, at the Redis stack',
    lede: 'Redis certification for developers who build on it: choosing the right data structure, caching with expiry, persistence and key management, client connections, and safe concurrent updates.',
    // The exam's five domains and their weights, from the Redis Associate Developer exam guide.
    covers: [
      ['Data modeling with Redis data structures', 46],
      ['Caching strategies and expiration', 20],
      ['Persistence, key lifecycle and operational commands', 15],
      ['Client library usage and connection management', 11],
      ['Concurrency, transactions and atomicity', 8],
    ],
    format: '65 questions · 90 minutes · pass mark 70% · valid for 2 years',
    facts: [
      ['Issuer', 'Redis', 1],
      ['Issued', 'Oct 2026', 2],
      ['Valid until', 'Oct 2028', 3],
    ],
    pulse: 'redis',
  },
];
---

<Base
  title={`Résumé | ${site.name}`}
  description="Résumé: AI engineer. Work experience, projects, skills, education, and AWS and Redis certifications."
>
  <div class="wrap rpage">
    <header class="rh">
      <Portrait class="rport" size={190} loading="eager" />
      <p class="kicker">Résumé</p>
      <h1>Imtiaz Mashrafee Samin</h1>
      <p class="rrole">AI Engineer</p>
      <ul class="meta" aria-label="Contact">
        <li>{contact.place}</li>
        <li>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li>
          <a href={contact.linkedin} rel="noopener">
            LinkedIn
          </a>
        </li>
        <li>
          <a href={contact.github} rel="noopener">
            GitHub
          </a>
        </li>
      </ul>
      <div class="ractions">
        <a class="btn" href="/work/">
          Case studies
        </a>
      </div>
    </header>

    <p class="profile">
      AI Engineer with industry experience building and deploying LLM, RAG, and machine-learning systems.
      Experienced across PyTorch, retrieval systems, Docker/CI/CD, and production AI deployments, with
      research focused on transformer robustness and backdoor defense.
    </p>

    <DevRoom work={work} points={work.points} certs={certs} />

    <div class="rgrid">
      <div class="rmain">
        <section aria-labelledby="proj-h">
          <h2 id="proj-h">
            <span>03</span> Projects
          </h2>
          {projects.map((p) => (
            <article class="entry">
              <div class="etop">
                <h3>{p.title}</h3>
              </div>
              <p class="esum">{p.line}</p>
              <ul class="points">
                {p.points.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
              <ul class="chips" aria-label="Technologies">
                {p.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
              {p.case && (
                <p class="elink">
                  <a class="arrow-link" href={p.case.href}>
                    {p.case.label} →
                  </a>
                </p>
              )}
            </article>
          ))}
        </section>
      </div>

      <aside class="rside">
        <section aria-labelledby="skills-h">
          <h2 id="skills-h">
            <span>04</span> Core skills
          </h2>
          {skills.map((s) => (
            <div class="sk">
              <h3>{s.group}</h3>
              <ul class="chips">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))}
        </section>

        <section aria-labelledby="edu-h">
          <h2 id="edu-h">
            <span>05</span> Education
          </h2>
          <div class="edu">
            <h3>BRAC University</h3>
            <p>Computer Science</p>
            <p class="muted mono">Sep 2022 to Sep 2026 &nbsp;/&nbsp; CGPA 3.65</p>
            <p class="thesis">
              <span class="mono muted">Thesis</span>
              Data-Free Backdoor Removal From Privately Fine-Tuned BERT Classifiers
            </p>
          </div>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .rpage {
    padding-block: clamp(32px, 6vh, 64px) var(--s5);
  }
  .rh {
    position: relative;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }
  .rh :global(.rport) {
    position: absolute;
    top: 22px;
    right: 14px;
  }
  @media (min-width: 1000px) {
    h1 {
      max-width: calc(100% - 250px);
    }
  }
  @media (max-width: 999px) {
    .rh :global(.rport) {
      position: relative;
      top: 0;
      right: 0;
      margin: 12px 0 28px 11px;
    }
  }
  .kicker {
    margin: 0 0 12px;
    color: var(--accent);
    font: 500 12px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .kicker::after {
    content: '';
    display: inline-block;
    width: 40px;
    height: 1px;
    margin-left: 12px;
    background: var(--accent);
    vertical-align: middle;
  }
  h1 {
    margin: 0;
    font: 400 clamp(2.6rem, 5.6vw, 4.6rem) / 1 var(--serif);
    letter-spacing: -0.02em;
  }
  .rrole {
    margin: 10px 0 0;
    color: var(--accent);
    font: italic 400 clamp(1.4rem, 2.6vw, 2rem) / 1.1 var(--serif);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 20px 0 0;
    padding: 0;
    color: var(--muted);
    font: 400 var(--t-mono) var(--mono);
    list-style: none;
  }
  .meta a {
    color: var(--text);
  }
  .ractions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 24px;
  }
  .profile {
    max-width: 62ch;
    margin: 32px 0 40px;
    font: 400 clamp(1.2rem, 1.9vw, 1.5rem) / 1.5 var(--serif);
  }
  .rgrid {
    display: grid;
    grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 18px;
    padding-top: 16px;
    border-top: 2px solid var(--accent);
    font: 500 12px var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  h2 span {
    color: var(--accent);
  }
  section + section {
    margin-top: 44px;
  }
  .entry {
    position: relative;
    margin-bottom: 36px;
    padding-left: 22px;
    border-left: 1px solid var(--rule);
  }
  .entry::before {
    content: '';
    position: absolute;
    top: 7px;
    left: -5px;
    width: 9px;
    height: 9px;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }
  .etop {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 20px;
  }
  .entry h3 {
    margin: 0;
    font: 600 1.25rem / 1.25 var(--sans);
  }
  .at {
    color: var(--muted);
    font-weight: 400;
  }
  .edate {
    margin: 0;
    color: var(--text);
    font: 500 var(--t-mono) var(--mono);
    text-align: right;
  }
  .edate span {
    display: block;
    color: var(--muted);
    font-weight: 400;
  }
  .esum {
    margin: 10px 0 12px;
    color: var(--muted);
    font: 400 1.02rem / 1.55 var(--sans);
  }
  .points {
    display: grid;
    gap: 9px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }
  .points li {
    position: relative;
    padding-left: 20px;
    font: 400 1.02rem / 1.55 var(--sans);
  }
  .points li::before {
    content: '\25B8';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 3px 9px;
    border: 1px solid var(--rule);
    color: var(--muted);
    font: 400 12px var(--mono);
  }
  .elink {
    margin: 14px 0 0;
  }
  .rside h3 {
    margin: 0 0 8px;
    font: 600 1rem / 1.3 var(--sans);
  }
  .sk {
    margin-bottom: 20px;
  }
  .sk h3 {
    color: var(--muted);
    font: 400 12px var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .edu p,
  .cert p {
    margin: 0 0 4px;
  }
  .edu .thesis {
    margin-top: 12px;
    padding-left: 14px;
    border-left: 2px solid var(--accent);
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .edu .thesis .mono {
    display: block;
    margin-bottom: 2px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cert {
    margin-bottom: 18px;
    padding: 12px 14px;
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .cert > div {
    min-width: 0;
  }
  .clogo {
    flex: none;
    width: 84px;
    height: 84px;
    object-fit: contain;
  }
  @media (min-width: 1000px) {
    .rside {
      position: sticky;
      top: 20px;
    }
  }
  @media (max-width: 999px) {
    .rgrid {
      grid-template-columns: 1fr;
    }
    .edate {
      text-align: left;
    }
  }
</style>
